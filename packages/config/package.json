{
  "name": "@dripplex/config",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Shared TypeScript, ESLint, and Prettier configuration for the Dripplex monorepo.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    "./typescript/base": "./typescript/base.json",
    "./typescript/nextjs": "./typescript/nextjs.json",
    "./typescript/nestjs": "./typescript/nestjs.json",
    "./typescript/react-library": "./typescript/react-library.json",
    "./eslint/base": "./eslint/base.js",
    "./eslint/nextjs": "./eslint/nextjs.js",
    "./eslint/nestjs": "./eslint/nestjs.js",
    "./eslint/react-library": "./eslint/react-library.js",
    "./prettier": "./prettier/index.json",
    "./next/security-headers": "./next/security-headers.js"
  },
  "files": [
    "typescript",
    "eslint",
    "prettier",
    "next"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf .turbo"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.0.0"
  }
}
