{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": ["eslint/**/*.js", "eslint.config.js", "types/**/*.d.ts"],
  "exclude": ["node_modules"]
}
