{
  "name": "@dripplex/hooks",
  "version": "1.0.0",
  "private": true,
  "description": "Dripplex shared React hooks for auth, queries, and portal UX patterns.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./notifications/native-push": {
      "types": "./src/notifications/native-push.ts",
      "default": "./src/notifications/native-push.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@capacitor/core": "^7.2.0",
    "@capacitor/push-notifications": "^7.0.1",
    "@dripplex/sdk": "workspace:*",
    "@dripplex/types": "workspace:*",
    "@dripplex/ui": "workspace:*",
    "@tanstack/react-query": "^5.62.8",
    "firebase": "^12.17.0",
    "lucide-react": "^0.469.0",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dripplex/config": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^3.2.7"
  }
}
