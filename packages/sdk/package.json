{
  "name": "@dripplex/sdk",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Dripplex typed HTTP client for api/v1 consumers across web portals.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "import": "./dist/sdk.js"
    },
    "./sdk-merchant": {
      "types": "./dist/sdk-merchant.d.ts",
      "import": "./dist/sdk-merchant.js"
    },
    "./sdk-rider": {
      "types": "./dist/sdk-rider.d.ts",
      "import": "./dist/sdk-rider.js"
    },
    "./sdk-admin": {
      "types": "./dist/sdk-admin.d.ts",
      "import": "./dist/sdk-admin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@dripplex/types": "workspace:*"
  },
  "devDependencies": {
    "@dripplex/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}
