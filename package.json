{
  "name": "dripplex-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dripplex — life, Simplified. Nigerian Super Platform monorepo.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "sharp": ">=0.35.0",
      "postcss": ">=8.5.23",
      "nanoid": "^3.3.17",
      "uuid": ">=11.1.1",
      "vite": ">=6.4.3",
      "esbuild": ">=0.25.0",
      "undici": ">=7.29.0",
      "fast-uri": ">=3.1.5",
      "deepmerge-ts": ">=8.0.0",
      "minimatch@8>brace-expansion": "^2.0.2",
      "minimatch@9>brace-expansion": "^2.0.2",
      "minimatch@10>brace-expansion": ">=5.0.9",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.2"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-mh99-v99m-4gvg"
      ]
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test --filter=./packages/* --filter=./apps/backend",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@dripplex/config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --config apps/backend/eslint.config.mjs"
    ],
    "apps/customer-web/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config apps/customer-web/eslint.config.mjs"
    ],
    "packages/types/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config packages/types/eslint.config.js"
    ],
    "packages/utils/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config packages/utils/eslint.config.js"
    ],
    "packages/sdk/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config packages/sdk/eslint.config.js"
    ],
    "packages/ui/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config packages/ui/eslint.config.js"
    ],
    "packages/hooks/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config packages/hooks/eslint.config.js"
    ],
    "packages/config/**/*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --config packages/config/eslint.config.js"
    ],
    "apps/merchant-portal/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config apps/merchant-portal/eslint.config.mjs"
    ],
    "apps/rider-portal/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config apps/rider-portal/eslint.config.mjs"
    ],
    "apps/admin-portal/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config apps/admin-portal/eslint.config.mjs"
    ],
    "apps/operations-console/src/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --config apps/operations-console/eslint.config.mjs"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
