{
  "name": "@dripplex/merchant-portal",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Dripplex merchant portal \u2014 live Backend Core integration via sdk-merchant.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --port ${MERCHANT_PORTAL_PORT:-3002}",
    "build": "next build",
    "start": "next start --port ${MERCHANT_PORTAL_PORT:-3002}",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf .next .turbo node_modules/.cache coverage"
  },
  "dependencies": {
    "@dripplex/hooks": "workspace:*",
    "@dripplex/sdk": "workspace:*",
