NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3005
# Browser Google Maps key — same key as customer-web/driver-portal. Optional
# for local dev: the Live Fleet Map falls back to a list-only view when this
# is unset rather than crashing (see src/lib/google-maps-config.ts). Required
# for a real production deploy — see docs/ops/PRODUCTION-COOLIFY.md.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
