# Capacitor remote shell URL (customer-web deployment)
CAPACITOR_SERVER_URL=https://app.dripplex.com

# Android signing (CI secrets — never commit keystore)
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# FCM (place google-services.json in android/app/)
GOOGLE_SERVICES_JSON_PATH=android/app/google-services.json

# APNS (place GoogleService-Info.plist in ios/App/App/ for FCM bridge)
GOOGLE_SERVICE_INFO_PLIST_PATH=ios/App/App/GoogleService-Info.plist

# Build flavor: production | internal | closedBeta
ANDROID_FLAVOR=production
