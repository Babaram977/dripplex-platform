<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- HTTPS App Links (verify assetlinks.json on app.dripplex.com) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="app.dripplex.com" />
            </intent-filter>

            <!-- Custom scheme fallback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dripplex" android:host="open" />
            </intent-filter>

        </activity>

        <!--
            DPX-MOBILE-003 — driver presence.

            A driver who minimised DrippleX went invisible to dispatch about
            four minutes later: the heartbeat was a WebView setInterval, and
            Android freezes those. This service keeps reporting natively.

            foregroundServiceType="location" is required from Android 14, and
            the typed startForeground() overload must agree with it. It needs
            no ACCESS_BACKGROUND_LOCATION — a foreground service IS the
            sanctioned way to hold location with the app backgrounded, and the
            permission covers the two cases this does not do: location with no
            service at all, and STARTING such a service from the background.
            This one starts from the driver tapping "Go online", on screen.

            exported="false": nothing outside the app may start it. It carries
            an access token.
        -->
        <service
            android:name=".DriverPresenceService"
            android:exported="false"
            android:stopWithTask="true"
            android:foregroundServiceType="location" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!--
        Deliberately minimal. Each line below is required by a shipped feature;
        nothing is declared "just in case", because every permission is a Play
        review question and a prompt the user has to say yes to.

        Vibrate: DPX-MOBILE-001. The ride-alert notification channel is created
        with vibration enabled, but the system performs that vibration on the
        app's behalf and checks this permission before it does. Without the line
        below the channel reports itself as vibrating and never does — a silent
        failure with no log, on the half of the alert that still works when the
        handset is on silent. Install-time and normal-level: no runtime prompt,
        no Play policy question.

        Location: Capacitor bridges navigator.geolocation to the platform
        provider, which cannot be granted a permission the app never declared.
        Without these two, getCurrentPosition fails on device and takes
        checkout, ride pickup, merchant onboarding and — worst — the two-minute
        driver/rider heartbeat with it. A driver then reads "You are live"
        while dispatch cannot see them.

        NOT declared, on purpose:
        - ACCESS_BACKGROUND_LOCATION. The heartbeat runs on navigator.geolocation
          inside a WebView, which only executes while the app is foregrounded.
          Declaring it would trigger a Play policy review we would fail, for a
          capability we do not have.
        - CAMERA. Not "never" — "not yet". Camera is a real product need
          (payment receipts, documents, and face verification if Smile Identity
          is engaged), but every capture path shipping today is a file input:
          checkoutScreen.tsx:1647, riderScreen.tsx:1040, screensB.tsx:1818.
          getUserMedia appears nowhere in the codebase. Android satisfies file
          inputs by intent to the camera app, which needs no permission from us,
          and declaring CAMERA while ungranted can actually break
          ACTION_IMAGE_CAPTURE — so adding it now would risk the capture that
          already works. Add it with the Smile Identity work, where face
          verification opens a live stream in-app and genuinely requires it,
          together with a runtime permission request (Capacitor's WebView does
          not grant getUserMedia on its own). Resolved 2026-08-21; see
          docs/store/DPX-MOBILE-002-PRIVACY-PERMISSIONS-AUDIT.md.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        DPX-MOBILE-003. Both are normal, install-time permissions: no runtime
        prompt, no Play policy question, no prominent-disclosure flow. The
        service they enable is what keeps a minimised driver visible to
        dispatch. See the <service> declaration above for why
        ACCESS_BACKGROUND_LOCATION is still, correctly, absent.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!--
        DPX-MOBILE-003, founder decision 2026-08-27: the floating driver bubble.

        The one permission in this manifest the user grants BY HAND. There is no
        runtime dialog for SYSTEM_ALERT_WINDOW — the app can only check
        Settings.canDrawOverlays() and send the driver to
        ACTION_MANAGE_OVERLAY_PERMISSION. So "not granted" is an ordinary state
        the code treats as normal, never as an error: a driver who declines it
        keeps a fully working shift and simply has no circle.

        Android's own permission-free bubble API was considered and does not
        fit: it needs API 30+ with a sharing shortcut and a conversation-style
        notification, and this app is minSdk 23 — most handsets in the launch
        market would get nothing.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
</manifest>
