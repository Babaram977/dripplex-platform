require_relative '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.6.8_@capacitor+core@7.6.8/node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../../../node_modules/.pnpm/@capacitor+app@7.1.2_@capacitor+core@7.6.8/node_modules/@capacitor/app'
  pod 'CapacitorPushNotifications', :path => '../../../../node_modules/.pnpm/@capacitor+push-notifications@7.0.7_@capacitor+core@7.6.8/node_modules/@capacitor/push-notifications'
  pod 'CapacitorSplashScreen', :path => '../../../../node_modules/.pnpm/@capacitor+splash-screen@7.0.5_@capacitor+core@7.6.8/node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../../../node_modules/.pnpm/@capacitor+status-bar@7.0.6_@capacitor+core@7.6.8/node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods

  # FirebaseMessaging — DPX-MOBILE-001, added 2026-09-18.
  #
  # The backend sends push through firebase-admin (FCM), and DeviceToken stores
  # FCM registration tokens. Without this pod the app can only ever obtain an
  # APNs token, which FCM rejects — and the backend then deactivates the device
  # as a bad token. AppDelegate bridges APNs -> FCM; this is what gives it
  # something to bridge with.
  #
  # Messaging only. FirebaseAnalytics is NOT wanted: it is a second SDK, a
  # second privacy-manifest surface, and a tracking question the App Store
  # listing currently answers with "tracking = false".
  pod 'FirebaseMessaging'
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
