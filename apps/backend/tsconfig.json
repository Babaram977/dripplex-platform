{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@dripplex/config/typescript/nestjs",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"]
    },
    "types": ["node", "jest"],
    "strictPropertyInitialization": false,
    "noEmit": true
  },
  "include": ["src/**/*", "prisma/**/*", "test/**/*", "jest.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
