  direction     WalletDirection
  balanceAfter  Decimal               @map("balance_after") @db.Decimal(14, 2)
  referenceType String?               @map("reference_type") @db.VarChar(100)
  referenceId   String?               @map("reference_id") @db.Uuid
  description   String?               @db.VarChar(500)
  metadata      Json?
  createdAt     DateTime              @default(now()) @map("created_at")
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, referenceType, referenceId], map: "wallet_ledger_entries_wallet_id_reference_type_reference_id_key")
  @@index([walletId])
  @@index([walletId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("wallet_ledger_entries")
}

/**
 * A card top-up of a wallet's balance — distinct from RidePaymentTransaction/
 * PaymentTransaction (which pay for a specific ride/order) because a wallet
 * top-up has no order/ride to attach to; walletOwnerType/walletOwnerId
 * mirror Wallet's own polymorphic owner fields rather than a foreign key.
 */
model WalletTopUpTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  walletOwnerType       WalletOwnerType   @map("wallet_owner_type")
  walletOwnerId         String            @map("wallet_owner_id") @db.Uuid
  provider              PaymentProvider
  providerReference     String            @unique @map("provider_reference") @db.VarChar(100)
  providerTransactionId String?           @map("provider_transaction_id") @db.VarChar(100)
  status                TransactionStatus @default(PENDING)
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("NGN") @db.VarChar(3)
  authorizationUrl      String?           @map("authorization_url") @db.VarChar(2048)
  accessCode            String?           @map("access_code") @db.VarChar(100)
  gatewayResponse       Json?             @map("gateway_response")
  paidAt                DateTime?         @map("paid_at")
  verifiedAt            DateTime?         @map("verified_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([walletOwnerType, walletOwnerId])
  @@index([providerReference])
  @@index([status])
  @@map("wallet_topup_transactions")
}

/**
 * A customer's own withdrawal destination — distinct from the merchant-only
 * `BankAccount` model (different ownership semantics, kept as separate
 * tables rather than generalizing one to serve both). Self-attested, like
 * `BankAccount`: no bank-account-verification API is integrated anywhere in
 * the platform yet (see docs/WALLET-004-WITHDRAW-DESIGN.md).
 */
model CustomerBankAccount {
  id            String              @id @default(uuid()) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  bankName      String              @map("bank_name") @db.VarChar(150)
  bankCode      String?             @map("bank_code") @db.VarChar(20)
  /// What the bank says, when name enquiry ran — not what the customer
  /// typed. See `accountNameVerifiedAt`.
  accountName   String              @map("account_name") @db.VarChar(150)
  accountNumber String              @map("account_number") @db.VarChar(20)
  /// When the account holder's name was confirmed with the bank.
  ///
  /// Null means the name is self-attested: either the row predates name
  /// enquiry (DPX-WALLET-001 Phase 0) or no resolver was configured when it
  /// was added. Null is **not** "failed verification" — a rejected account is
  /// never saved at all.
  accountNameVerifiedAt DateTime?   @map("account_name_verified_at")
  isDefault     Boolean             @default(false) @map("is_default")
  createdAt     DateTime            @default(now()) @map("created_at")
  deletedAt     DateTime?           @map("deleted_at")
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawals   WithdrawalRequest[]

  @@unique([userId, accountNumber])
  @@index([userId])
  @@index([userId, isDefault])
  @@map("customer_bank_accounts")
}

/**
 * A hashed PIN gating withdrawal requests. bcrypt, same salt-rounds config
 * as password hashing (`AppConfigService.bcryptSaltRounds`) — no new hashing
 * scheme introduced.
 */
model WalletPin {
  userId    String   @id @map("user_id") @db.Uuid
  pinHash   String   @map("pin_hash")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallet_pins")
}

enum WithdrawalRequestStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * The wallet is debited at request creation (PENDING), not at completion —
 * see docs/WALLET-004-WITHDRAW-DESIGN.md for the reasoning. A FAILED outcome
 * reverses the debit via a real WalletService.credit() call referencing this
 * row's id, so the reversal is idempotent under the same
 * (walletId, referenceType, referenceId) uniqueness WalletLedgerEntry already
 * enforces for every other mutation.
 */
model WithdrawalRequest {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @map("user_id") @db.Uuid
  walletId          String                  @map("wallet_id") @db.Uuid
  bankAccountId     String                  @map("bank_account_id") @db.Uuid
  amount            Decimal                 @db.Decimal(14, 2)
  currency          String                  @default("NGN") @db.VarChar(3)
  status            WithdrawalRequestStatus @default(PENDING)
  failureReason     String?                 @map("failure_reason") @db.VarChar(500)
  adminNote         String?                 @map("admin_note") @db.VarChar(500)
  processedByUserId String?                 @map("processed_by_user_id") @db.Uuid
  processedAt       DateTime?               @map("processed_at")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  user              User                    @relation("WithdrawalRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  bankAccount       CustomerBankAccount     @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  processedBy       User?                   @relation("WithdrawalRequestProcessedBy", fields: [processedByUserId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("withdrawal_requests")
}

enum ReferralRedemptionStatus {
  PENDING
  REWARDED
  EXPIRED
}

/// Whose referral code this is, and therefore which wallet their reward is
/// paid into.
///
/// Recorded on the row rather than derived from the holder's profiles at
/// payout time: a customer who later signs up to drive must not have their
/// past referral rewards retroactively redirected to a wallet they did not
/// earn them in. Founder decision, 2026-08-26 — a driver's referral reward is
/// wallet cash in their DRIVER wallet, paid on the referred customer's first
/// completed ride.
enum ReferralOwnerType {
  CUSTOMER
  DRIVER
}

/// One row per user who has generated a referral code (lazily created on
/// first request). The code is what the referrer shares.
model Referral {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @unique @map("user_id") @db.Uuid
  /// CUSTOMER unless the code was issued through the driver app.
  ownerType   ReferralOwnerType    @default(CUSTOMER) @map("owner_type")
  code        String               @unique @db.VarChar(16)
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@index([code])
  @@map("referrals")
}

/// One row per referred user (a referee can only be referred once — see
/// the unique constraint on refereeUserId). Reward crediting is deferred
/// until the referee completes their first ride (see referral-reward
/// .subscriber.ts) rather than at signup, to reduce free-money fraud.
model ReferralRedemption {
  id            String                   @id @default(uuid()) @db.Uuid
  referralId    String                   @map("referral_id") @db.Uuid
  refereeUserId String                   @unique @map("referee_user_id") @db.Uuid
  status        ReferralRedemptionStatus @default(PENDING)
  rewardedAt    DateTime?                @map("rewarded_at")
  createdAt     DateTime                 @default(now()) @map("created_at")
  updatedAt     DateTime                 @updatedAt @map("updated_at")
  referral      Referral                 @relation(fields: [referralId], references: [id], onDelete: Cascade)
  refereeUser   User                     @relation(fields: [refereeUserId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([status])
  @@map("referral_redemptions")
}

enum ReferralCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ReferralCampaignTier {
  NONE
  SILVER
  GOLD
}

enum PassengerReferralStatus {
  REGISTERED
  QUALIFIED
}

enum DriverReferralRewardStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum ReferralFraudCheckType {
  SELF_REFERRAL
  DUPLICATE_REFEREE
  MANUAL_FLAG
}

enum ReferralFraudCheckStatus {
  CLEARED
  FLAGGED
  REJECTED
}

/// Driver Growth Campaign — a monthly driver-refers-passenger program,
/// distinct from (but living alongside) the generic customer Referral
/// model above. One campaign row per calendar month.
model ReferralCampaign {
  id                        String                 @id @default(uuid()) @db.Uuid
  name                      String                 @db.VarChar(150)
  periodStart               DateTime               @map("period_start")
  periodEnd                 DateTime               @map("period_end")
  status                    ReferralCampaignStatus @default(DRAFT)
  requiredTripsPerPassenger Int                    @default(5) @map("required_trips_per_passenger")
  silverThreshold           Int                    @default(50) @map("silver_threshold")
  silverRewardAmount        Decimal                @default(40000) @map("silver_reward_amount") @db.Decimal(12, 2)
  goldThreshold             Int                    @default(100) @map("gold_threshold")
  goldRewardAmount          Decimal                @default(100000) @map("gold_reward_amount") @db.Decimal(12, 2)
  goldQualificationRate     Decimal                @default(0.75) @map("gold_qualification_rate") @db.Decimal(4, 3)
  createdBy                 String?                @map("created_by") @db.Uuid
  createdAt                 DateTime               @default(now()) @map("created_at")
  updatedAt                 DateTime               @updatedAt @map("updated_at")
  driverReferrals           DriverReferral[]
  rewards                   ReferralReward[]

  @@unique([periodStart, periodEnd])
  @@index([status])
  @@map("referral_campaigns")
}

/// One row per driver per campaign — holds the driver's unique code for
/// that campaign month. Live progress rollups live in ReferralStatistics
/// (below), not here, so dashboard reads never need to aggregate
/// PassengerReferral rows.
model DriverReferral {
  id                 String              @id @default(uuid()) @db.Uuid
  campaignId         String              @map("campaign_id") @db.Uuid
  driverId           String              @map("driver_id") @db.Uuid
  code               String              @unique @db.VarChar(16)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  campaign           ReferralCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  driver             User                @relation(fields: [driverId], references: [id], onDelete: Cascade)
  passengerReferrals PassengerReferral[]
  statistics         ReferralStatistics?

  @@unique([campaignId, driverId])
  @@index([code])
  @@index([driverId])
  @@map("driver_referrals")
}

/// Live rollup of a driver's progress within one campaign — updated
/// incrementally in the same transaction as each underlying state change
/// (invite tap, passenger registration, passenger qualification), not
/// recomputed by aggregate query on every dashboard read. invitesSent is
/// the one figure with no other source of truth: it counts share-button
/// taps (POST .../invite), since there is no real invite-delivery
/// mechanism (SMS/email) to count against — an honest "shared" counter,
/// not a fabricated "sent" guarantee.
model ReferralStatistics {
  id               String               @id @default(uuid()) @db.Uuid
  driverReferralId String               @unique @map("driver_referral_id") @db.Uuid
  invitesSent      Int                  @default(0) @map("invites_sent")
  registeredCount  Int                  @default(0) @map("registered_count")
  qualifiedCount   Int                  @default(0) @map("qualified_count")
  completedTrips   Int                  @default(0) @map("completed_trips")
  currentTier      ReferralCampaignTier @default(NONE) @map("current_tier")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  driverReferral   DriverReferral       @relation(fields: [driverReferralId], references: [id], onDelete: Cascade)

  @@map("referral_statistics")
}

/// One row per passenger referred through a driver's campaign code.
/// refereeUserId is unique platform-wide — a passenger can only be
/// counted toward one driver, one campaign, ever (mirrors
/// ReferralRedemption's refereeUserId uniqueness above).
model PassengerReferral {
  id               String                  @id @default(uuid()) @db.Uuid
  driverReferralId String                  @map("driver_referral_id") @db.Uuid
  refereeUserId    String                  @unique @map("referee_user_id") @db.Uuid
  status           PassengerReferralStatus @default(REGISTERED)
  completedTrips   Int                     @default(0) @map("completed_trips")
  qualifiedAt      DateTime?               @map("qualified_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")
  driverReferral   DriverReferral          @relation(fields: [driverReferralId], references: [id], onDelete: Cascade)
  refereeUser      User                    @relation(fields: [refereeUserId], references: [id], onDelete: Cascade)
  fraudChecks      ReferralFraudCheck[]

  @@index([driverReferralId])
  @@index([status])
  @@map("passenger_referrals")
}

/// One row per driver per campaign — created/updated as the driver's tier
/// improves, never duplicated (unique on campaignId+driverId), so "only
/// one reward tier is paid per campaign" is a schema-level guarantee, not
/// just application logic. status doubles as the payment-status tracker:
/// PENDING (accruing, not yet reviewed) -> APPROVED -> PAID, or REJECTED.
model ReferralReward {
  id                      String                     @id @default(uuid()) @db.Uuid
  campaignId              String                     @map("campaign_id") @db.Uuid
  driverId                String                     @map("driver_id") @db.Uuid
  tier                    ReferralCampaignTier
  amount                  Decimal                    @db.Decimal(12, 2)
  qualifiedPassengerCount Int                        @map("qualified_passenger_count")
  status                  DriverReferralRewardStatus @default(PENDING)
  approvedAt              DateTime?                  @map("approved_at")
  approvedBy              String?                    @map("approved_by") @db.Uuid
  rejectedAt              DateTime?                  @map("rejected_at")
  rejectedBy              String?                    @map("rejected_by") @db.Uuid
  rejectionReason         String?                    @map("rejection_reason") @db.VarChar(500)
  paidAt                  DateTime?                  @map("paid_at")
  createdAt               DateTime                   @default(now()) @map("created_at")
  updatedAt               DateTime                   @updatedAt @map("updated_at")
  campaign                ReferralCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  driver                  User                       @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([campaignId, driverId])
  @@index([status])
  @@map("referral_rewards")
}

/// Automated + manual fraud review trail. Only SELF_REFERRAL and
/// DUPLICATE_REFEREE are checks this codebase can actually verify today
/// (no device fingerprinting / IP correlation infrastructure exists) —
/// MANUAL_FLAG is how an admin records a judgment call that isn't
/// mechanically detectable. See design doc for what's real vs. not.
model ReferralFraudCheck {
  id                  String                   @id @default(uuid()) @db.Uuid
  passengerReferralId String?                  @map("passenger_referral_id") @db.Uuid
  driverReferralId    String?                  @map("driver_referral_id") @db.Uuid
  checkType           ReferralFraudCheckType   @map("check_type")
  status              ReferralFraudCheckStatus @default(CLEARED)
  details             String?                  @db.VarChar(1000)
  reviewedAt          DateTime?                @map("reviewed_at")
  reviewedBy          String?                  @map("reviewed_by") @db.Uuid
  createdAt           DateTime                 @default(now()) @map("created_at")
  passengerReferral   PassengerReferral?       @relation(fields: [passengerReferralId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([passengerReferralId])
  @@map("referral_fraud_checks")
}

model AnalyticsDailyMetric {
  id          String             @id @default(uuid()) @db.Uuid
  metricDate  DateTime           @map("metric_date") @db.Date
  scopeType   AnalyticsScopeType @map("scope_type")
  scopeId     String?            @map("scope_id") @db.Uuid
  metricKey   String             @map("metric_key") @db.VarChar(150)
  metricValue Decimal            @map("metric_value") @db.Decimal(18, 4)
  metadata    Json?
  createdAt   DateTime           @default(now()) @map("created_at")

  @@unique([metricDate, scopeType, scopeId, metricKey])
  @@index([metricDate])
  @@index([scopeType, scopeId])
  @@index([metricKey])
  @@map("analytics_daily_metrics")
}

model CmsContent {
  id          String              @id @default(uuid()) @db.Uuid
  type        CmsContentType
  slug        String              @unique @db.VarChar(150)
  title       String              @db.VarChar(255)
  body        Json?
  status      CmsContentStatus    @default(DRAFT)
  version     Int                 @default(1)
  publishedAt DateTime?           @map("published_at")
  scheduledAt DateTime?           @map("scheduled_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  deletedAt   DateTime?           @map("deleted_at")
  versions    CmsContentVersion[]

  @@index([type])
  @@index([status])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([deletedAt])
  @@map("cms_contents")
}

model CmsContentVersion {
  id        String     @id @default(uuid()) @db.Uuid
  contentId String     @map("content_id") @db.Uuid
  version   Int
  title     String     @db.VarChar(255)
  body      Json?
  createdBy String?    @map("created_by") @db.Uuid
  createdAt DateTime   @default(now()) @map("created_at")
  content   CmsContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  creator   User?      @relation("CmsContentVersionCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([contentId, version])
  @@index([contentId])
  @@index([createdBy])
  @@map("cms_content_versions")
}

model FraudSignal {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String?           @map("user_id") @db.Uuid
  orderId           String?           @map("order_id") @db.Uuid
  paymentId         String?           @map("payment_id") @db.Uuid
  signalType        String            @map("signal_type") @db.VarChar(100)
  riskScore         Int               @map("risk_score")
  riskLevel         FraudRiskLevel    @map("risk_level")
  details           Json?
  ipAddress         String?           @map("ip_address") @db.VarChar(45)
  deviceFingerprint String?           @map("device_fingerprint") @db.VarChar(255)
  status            FraudReviewStatus @default(OPEN)
  reviewedBy        String?           @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?         @map("reviewed_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  deletedAt         DateTime?         @map("deleted_at")
  user              User?             @relation("FraudSignalUser", fields: [userId], references: [id], onDelete: SetNull)
  reviewer          User?             @relation("FraudSignalReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([orderId])
  @@index([paymentId])
  @@index([signalType])
  @@index([riskLevel])
  @@index([status])
  @@index([reviewedBy])
  @@index([deletedAt])
  @@map("fraud_signals")
}

model FraudListEntry {
  id         String         @id @default(uuid()) @db.Uuid
  listType   FraudListType  @map("list_type")
  matchType  FraudMatchType @map("match_type")
  matchValue String         @map("match_value") @db.VarChar(255)
  reason     String?        @db.VarChar(500)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  @@unique([listType, matchType, matchValue])
  @@index([active])
  @@index([matchType, matchValue])
  @@index([deletedAt])
  @@map("fraud_list_entries")
}

model FraudThreshold {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Float
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("fraud_thresholds")
}

/// DPX-OPS-001 Slice 2 — Operations Work Queues (founder-approved
/// 2026-08-04). `OperationsCase` is a wrapper layer over the three
/// existing Driver Slice 2 source tables (`SosAlert`, `IncidentReport`,
/// `DriverSupportTicket`) — it does not replace their own status fields,
/// which stay the driver-facing source of truth. It adds the operational
/// concepts those frozen tables don't have: a unified priority, a unified
/// six-stage lifecycle, operator/supervisor assignment, and SLA
/// timestamps. One row per (caseType, sourceId), created lazily
/// (get-or-create) the first time a source row is surfaced to Operations
/// — `drivers/sos`, `drivers/incidents`, `drivers/support` are never
/// modified, only composed via their existing public service methods.
enum OperationsCaseType {
  SOS
  INCIDENT
  SUPPORT
}

/// Unified priority across all three queues, per the founder's own scale.
/// SOS cases always default to CRITICAL.
enum OperationsPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// The founder's standard workflow: New -> Assigned -> In Progress ->
/// Waiting -> Resolved -> Closed. Not a strict linear state machine —
/// operators can move a case back to WAITING (e.g. "waiting on driver")
/// from IN_PROGRESS, and RESOLVED cases can be reopened to IN_PROGRESS
/// before being CLOSED.
enum OperationsLifecycleStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

enum OperationsAssigneeRole {
  OPERATOR
  SUPERVISOR
}

enum OperationsCaseEventType {
  CREATED
  PRIORITY_CHANGED
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGED
  NOTE_ADDED
}

model OperationsCase {
  id               String                    @id @default(uuid()) @db.Uuid
  caseType         OperationsCaseType        @map("case_type")
  /// Id of the SosAlert/IncidentReport/DriverSupportTicket row this case
  /// wraps. Deliberately a plain scalar, not a Prisma relation — those
  /// three models belong to the frozen Driver Slice 2 module and adding a
  /// relation would require back-relation fields on each of them.
  sourceId         String                    @map("source_id") @db.Uuid
  priority         OperationsPriority        @default(MEDIUM)
  status           OperationsLifecycleStatus @default(NEW)
  assignedToId     String?                   @map("assigned_to_id") @db.Uuid
  assignedToRole   OperationsAssigneeRole?   @map("assigned_to_role")
  assignedById     String?                   @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime?                 @map("assigned_at")
  /// SLA tracking, per the founder's requirement: created (createdAt
  /// below) / first response / assignment (assignedAt above) / resolution
  /// / closure.
  firstRespondedAt DateTime?                 @map("first_responded_at")
  resolvedAt       DateTime?                 @map("resolved_at")
  closedAt         DateTime?                 @map("closed_at")
  /// Optimistic-concurrency guard (DPX-OPS-001 module-closure audit,
  /// 2026-08-05, founder-mandated). Incremented on every `updateCase()`
  /// write. A caller must submit the `version` it last read; a mismatch
  /// means another operator's update landed first, and the write is
  /// rejected with a 409 rather than silently overwriting their change —
  /// see `OperationsCasesService.updateCase()`'s own doc comment for the
  /// concrete multi-operator scenario this closes.
  version          Int                       @default(0)
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  assignedTo       User?                     @relation("OperationsCaseAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedBy       User?                     @relation("OperationsCaseAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  events           OperationsCaseEvent[]

  @@unique([caseType, sourceId])
  @@index([caseType, status])
  @@index([priority])
  @@index([assignedToId])
  // DPX-OPS-001 module-level audit (2026-08-05):
  // OperationsAnalyticsService.getOperationsResponse() range-filters on
  // createdAt with no other predicate.
  @@index([createdAt])
  @@map("operations_cases")
}

/// Immutable event timeline — the operational audit log for a case. Rows
/// are only ever inserted, never updated or deleted.
model OperationsCaseEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  caseId      String                  @map("case_id") @db.Uuid
  eventType   OperationsCaseEventType @map("event_type")
  /// Null for system-generated events (e.g. the CREATED event logged by
  /// the lazy get-or-create, which has no human actor).
  actorId     String?                 @map("actor_id") @db.Uuid
  description String                  @db.VarChar(1000)
  createdAt   DateTime                @default(now()) @map("created_at")
  case        OperationsCase          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor       User?                   @relation("OperationsCaseEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([caseId, createdAt])
  @@map("operations_case_events")
}

/// DPX-CHAT-001 — the two live contexts in which two people need to talk:
/// a delivery (customer ↔ rider) and a ride (passenger ↔ driver). Scoping a
/// thread to the job itself is what makes authorisation decidable: the
/// participants ARE the job's parties, so there is no separate membership
/// table to drift out of step, and a thread cannot outlive its reason to
/// exist.
enum MessageContextType {
  DELIVERY
  RIDE
}

/// One message between the two parties of a delivery or a ride.
///
/// Deliberately not a general-purpose inbox: DrippleX has no
/// person-to-person messaging, and opening one would let a rider message a
/// customer they were never assigned to. Every row is anchored to a job, and
/// the service refuses to read or write unless the caller is one of that
/// job's two parties.
model Message {
  id          String             @id @default(uuid()) @db.Uuid
  contextType MessageContextType @map("context_type")
  /// DeliveryJob.id or Ride.id, per contextType. Not a foreign key because it
  /// points at one of two tables; the service resolves and authorises it.
  contextId   String             @map("context_id") @db.Uuid
  senderId    String             @map("sender_id") @db.Uuid
  recipientId String             @map("recipient_id") @db.Uuid
  body        String             @db.VarChar(2000)
  /// Set when the recipient has opened the thread — drives the unread badge.
  readAt      DateTime?          @map("read_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  sender      User               @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient   User               @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([contextType, contextId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

/// DPX-MOBILE-002 §4 — the lifecycle of one voice call.
///
/// `ANSWERED` is the live state; the rest are outcomes.
enum CallStatus {
  RINGING
  ANSWERED
  DECLINED
  /// Rang out without being answered or declined. Distinct from DECLINED
  /// because "nobody picked up" and "they said no" are different facts about
  /// a driver's responsiveness.
  MISSED
  /// Never connected — a media or network failure, not a human decision.
  /// Deliberately not folded into MISSED: DPX-MOBILE-002 §7 measures call
  /// completion rate to decide whether the fix is TURN coverage, codec choice
  /// or reconnection handling, and that is unanswerable if the platform's own
  /// failures are recorded as if the callee ignored the phone.
  FAILED
  ENDED
}

/// Why a call stopped. Paired with CallStatus rather than replacing it: the
/// status is what happened, this is who or what caused it.
enum CallEndedReason {
  CALLER_HANGUP
  CALLEE_HANGUP
  DECLINED
  TIMEOUT
  CONNECTION_FAILED
}

/// DPX-MOBILE-002 — one voice call between the two parties of a live job.
///
/// Anchored to a delivery or a ride exactly as `Message` is, and for the same
/// reason: there is no person-to-person calling in DrippleX, so a call can only
/// ever reach the other party of a job you are on. Authorisation is not stored
/// here — it is re-read from the job on every attempt by JobParticipantsService,
/// so a reassignment takes effect immediately.
///
/// **No audio is recorded** (founder decision, 2026-08-26). This row is
/// metadata only: who called whom, when, and how it ended.
model Call {
  id              String             @id @default(uuid()) @db.Uuid
  contextType     MessageContextType @map("context_type")
  /// DeliveryJob.id or Ride.id, per contextType. Not a foreign key because it
  /// points at one of two tables; the service resolves and authorises it.
  contextId       String             @map("context_id") @db.Uuid
  callerId        String             @map("caller_id") @db.Uuid
  calleeId        String             @map("callee_id") @db.Uuid
  status          CallStatus         @default(RINGING)
  /// Null while the call is still ringing or never connected. This is what
  /// makes "missed" measurable rather than inferred.
  answeredAt      DateTime?          @map("answered_at")
  endedAt         DateTime?          @map("ended_at")
  /// Answered → ended, in seconds. Null when the call was never answered.
  /// Stored rather than derived so a report cannot disagree with a receipt.
  durationSeconds Int?               @map("duration_seconds")
  endedReason     CallEndedReason?   @map("ended_reason")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  caller          User               @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee          User               @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)

  @@index([contextType, contextId, createdAt])
  @@index([calleeId, status])
  @@index([callerId, createdAt])
  @@map("calls")
}

// ── Utilities (DPX-UTILITIES-001 / -002) ────────────────────────────────────

/// The four bill-payment services launched with the Utilities tab. Peyflex
/// also sells betting, education pins, recharge-card printing and rented
/// phone numbers; those are deliberately out of scope
/// (DPX-UTILITIES-002 §5) and must not be added here without a founder
/// decision.
enum UtilityServiceType {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  /// Funding a bookmaker account. Verified before funding, like cable —
  /// money sent to a mistyped betting ID does not come back.
  BETTING
  /// WAEC / NECO / NABTEB result-checker PINs. The only service that is
  /// priced per unit and bought in quantity, and the only one besides
  /// electricity whose delivered artifact IS the thing purchased.
  EDUCATION
}

/// How the customer paid for a utility purchase. Deliberately its own enum
/// rather than reusing OrderPaymentMethod: utilities have no cash and no
/// pay-the-merchant path, and a shared enum would offer both.
enum UtilityPaymentMethod {
  WALLET
  PAYSTACK
  FLUTTERWAVE
}

/// PENDING is not a transient implementation detail — it is the state a row
/// is deliberately left in when the provider call times out. Peyflex accepts
/// no client idempotency key and exposes no status lookup for these four
/// services (DPX-UTILITIES-002 G1/G2), so after a timeout there is no
/// programmatic way to learn whether the float was spent. The row stays
/// PENDING with the customer's money still reserved, and an operator
/// resolves it by hand against the Peyflex dashboard.
enum UtilityPurchaseStatus {
  /// Card path only: the row exists, the gateway checkout has been opened,
  /// and no money has moved yet. Distinct from PENDING so the operator queue
  /// is not full of abandoned checkouts that need no action at all.
  AWAITING_PAYMENT
  PENDING
  SUCCESSFUL
  FAILED
  /// Terminal failure whose reservation has been given back — wallet
  /// credited, or a card refund initiated.
  REVERSED
}

/// One utility purchase. One table, not four: every service identifies its
/// target by a single string (a phone number, a meter number, a smartcard
/// number), so four nullable columns would be three-quarters empty on every
/// row.
model UtilityPurchase {
  id                 String                @id @default(uuid()) @db.Uuid
  serviceType        UtilityServiceType    @map("service_type")
  customerId         String                @map("customer_id") @db.Uuid
  /// Phone, meter or smartcard number — the thing being topped up.
  customerIdentifier String                @map("customer_identifier") @db.VarChar(64)
  /// Network or disco code taken from the provider catalogue, never
  /// free-typed by the client.
  providerCode       String                @map("provider_code") @db.VarChar(64)
  /// Data bundle or cable package. Null for airtime and for electricity,
  /// which are priced by amount rather than by plan.
  planCode           String?               @map("plan_code") @db.VarChar(64)
  /// How many units were bought. Only education PINs are sold in quantity;
  /// null everywhere else, so a receipt can say "3 × WAEC PIN" without
  /// implying every other service has a countable unit.
  quantity           Int?
  /// The name registered against the funded account, captured at
  /// verification. Stored only for BETTING, where Peyflex requires it on the
  /// funding call and the customer needs the receipt to show whose account
  /// was credited.
  beneficiaryName    String?               @map("beneficiary_name") @db.VarChar(120)
  /// What the customer was charged — face value.
  amountCharged      Decimal               @map("amount_charged") @db.Decimal(12, 2)
  /// What Peyflex debited from the DrippleX float. Null until the provider
  /// answers. The spread between this and amountCharged is DrippleX's margin
  /// (founder decision, DPX-UTILITIES-001 §2), and it is only auditable
  /// because both numbers are stored.
  providerCost       Decimal?              @map("provider_cost") @db.Decimal(12, 2)
  paymentMethod      UtilityPaymentMethod  @map("payment_method")
  /// The gateway reference for a card-paid purchase — null when paid from
  /// the wallet. Kept here rather than in a PaymentTransaction row because a
  /// utility purchase is not an order and PaymentTransaction is anchored to
  /// one.
  paymentReference   String?               @unique @map("payment_reference") @db.VarChar(100)
  status             UtilityPurchaseStatus @default(PENDING)
  /// Peyflex's own reference, for reconciliation and disputes. Peyflex
  /// generates it and returns it in the response — it cannot be supplied
  /// up front, which is the root of G1.
  providerReference  String?               @map("provider_reference") @db.VarChar(100)
  /// The electricity token or exam PIN(s). This is the thing the customer
  /// bought; a customer who closes the app and loses it has lost the money,
  /// so it is stored and re-displayable rather than shown once.
  ///
  /// Text, not VarChar(255): an education purchase returns every PIN it sold
  /// in one `||`-separated string — roughly 47 characters per PIN — so a
  /// quantity of six would have silently truncated, and a truncated PIN is a
  /// customer who paid and received nothing usable.
  deliveredToken     String?               @map("delivered_token")
  /// Shown to the customer and kept for support. Never carries the
  /// provider's own "Insufficient wallet balance" — that means the DrippleX
  /// float is dry, not the customer's, and reads as an accusation.
  failureReason      String?               @map("failure_reason") @db.VarChar(500)
  /// The raw provider response, for reconciling a disputed purchase against
  /// the Peyflex dashboard.
  providerResponse   Json?                 @map("provider_response")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  completedAt        DateTime?             @map("completed_at")
  customer           User                  @relation("UtilityPurchaseCustomer", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([status])
  @@index([serviceType, createdAt])
  @@index([providerReference])
  @@map("utility_purchases")
}

/// DPX-FLEET — a company that supplies riders or drivers to DrippleX.
///
/// Founder decision, 2026-08-30, after comparing Talabat's model: nearly all
/// of Talabat's ~20,000 riders work for fleet partners rather than the
/// platform. DrippleX takes the same shape — the fleet owns the vehicles,
/// employs the riders and negotiates their pay; DrippleX supplies the demand
/// and charges commission on it.
///
/// What DrippleX does NOT delegate is who may ride. KYC, identity
/// verification and onboarding stay with Operations exactly as they are for
/// every other rider and driver — the fleet decides who it employs, DrippleX
/// still decides who may work.
model Fleet {
  id String @id @default(uuid()) @db.Uuid

  /// The person who signs in to the fleet console. One console per owner.
  ownerId String @unique @map("owner_id") @db.Uuid

  /// The Fleet DX number the founder specified — the identifier a rider or
  /// driver is attached by. Human-readable and quotable over the phone,
  /// because that is how it will actually be used: an owner reads it to
  /// Operations, who attach the rider to it.
  fleetNumber String @unique @map("fleet_number") @db.VarChar(20)

  name         String  @db.VarChar(200)
  contactPhone String? @map("contact_phone") @db.VarChar(20)

  status FleetStatus @default(ACTIVE)

  /// A rate agreed with this fleet individually, overriding the volume bands.
  ///
  /// Founder decision 2026-08-30, "make it editable negotiable" — the same
  /// principle already applied to merchant credit limits on 2026-08-20:
  /// "limit should be individually set to each merchant because of business
  /// difference and it should be negotiated and agreed by DrippleX and
  /// merchant". A fleet of six cars and a fleet of a hundred bikes cannot
  /// share one table.
  ///
  /// Null means no individual agreement exists and the band table applies —
  /// which is also what keeps the table meaningful rather than something that
  /// silently overwrites a negotiated figure. Fraction, not percent.
  negotiatedRate  Decimal?  @map("negotiated_rate") @db.Decimal(5, 4)
  negotiatedBy    String?   @map("negotiated_by") @db.Uuid
  negotiatedAt    DateTime? @map("negotiated_at")
  negotiationNote String?   @map("negotiation_note") @db.VarChar(500)

  /// Suspending a fleet stops its members being dispatched without unpicking
  /// the membership rows, so it is reversible and leaves the history intact.
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason") @db.VarChar(500)

  /// When Operations let a self-registered fleet start trading.
  ///
  /// Founder decision 2026-08-30: an owner registers online and is issued
  /// their DX number immediately — they need it to give to their riders — but
  /// the fleet does not become a billable partner until DrippleX has checked
  /// it. Until then no rider is attached, no job counts and no commission
  /// accrues. Null on a fleet Operations created directly: creating it there
  /// *is* the approval.
  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid

  rejectedAt     DateTime? @map("rejected_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  owner   User                    @relation("FleetOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members FleetMember[]
  periods FleetCommissionPeriod[]

  @@index([status])
  @@index([deletedAt])
  @@map("fleets")
}

enum FleetStatus {
  /// Registered online, DX number issued, waiting for Operations to check it.
  /// Nothing counts and nothing is billed in this state.
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  /// Operations declined the application. Terminal — the owner registers again
  /// rather than a rejected fleet being quietly revived.
  REJECTED
}

/// One rider or driver working under one fleet.
///
/// The person keeps their own DrippleX account, their own KYC and their own
/// wallet. This row only records who they ride for.
model FleetMember {
  id      String @id @default(uuid()) @db.Uuid
  fleetId String @map("fleet_id") @db.Uuid
  userId  String @map("user_id") @db.Uuid

  role   FleetMemberRole
  status FleetMemberStatus @default(ACTIVE)

  /// Founder decision 2026-08-30: the owner may deactivate and reactivate his
  /// own people. Deactivating stops DrippleX dispatching to them while they
  /// remain on the fleet — a rider whose bike is in for repair, not a rider
  /// who has left.
  deactivatedAt     DateTime? @map("deactivated_at")
  deactivatedReason String?   @map("deactivated_reason") @db.VarChar(500)

  /// Removing detaches the person from the fleet and frees them to join
  /// another. It never deletes their DrippleX account: closing an account is
  /// an Operations action with its own commitments check, and one company
  /// must not be able to erase a person's identity, earnings history or the
  /// record of trips they have already done.
  removedAt DateTime? @map("removed_at")

  /// A rider who quoted this fleet's DX number during their own onboarding is
  /// a request, not a member.
  ///
  /// Founder decision 2026-08-30: riders type the number themselves, so the
  /// fleet owner has to confirm it. Without that, anyone could type any
  /// company's number and that company would be invoiced for their jobs.
  /// PENDING rows carry no `activeUserId`, so a mistyped number never blocks
  /// the rider from requesting the right fleet.
  approvedAt DateTime? @map("approved_at")
  approvedBy String?   @map("approved_by") @db.Uuid

  rejectedAt     DateTime? @map("rejected_at")
  rejectedReason String?   @map("rejected_reason") @db.VarChar(500)

  joinedAt  DateTime @default(now()) @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  user  User  @relation("FleetMembership", fields: [userId], references: [id], onDelete: Cascade)

  /// Null while the membership is over, the user id while it is live — so the
  /// database itself guarantees nobody rides for two fleets at once. Doing
  /// this with application checks alone loses to a race between two operators.
  activeUserId String? @map("active_user_id") @db.Uuid

  @@unique([activeUserId])
  /// A person may rejoin a fleet they previously left, so this is not unique
  /// on its own; `activeUserId` below is what stops two live memberships.
  @@index([fleetId, status])
  @@index([userId])
  @@map("fleet_members")
}

enum FleetMemberRole {
  RIDER
  DRIVER
}

enum FleetMemberStatus {
  /// The rider quoted this fleet's number at onboarding; the owner has not
  /// confirmed it yet. Not dispatched as a fleet rider, not counted, not
  /// billed.
  PENDING
  ACTIVE
  DEACTIVATED
  REMOVED
  /// The owner said this person does not work for them.
  REJECTED
}

/// The volume bands that decide a fleet's commission rate.
///
/// Data rather than constants, deliberately. The founder gave 999-4,999 at 8%
/// and 5,000-9,999 at 6.5% as an illustration ("something like that"), and the
/// bands below and above those were never set. Operations enters the real
/// table and edits it per negotiation without waiting for a deploy, which also
/// means no band was ever invented in code.
model FleetCommissionTier {
  id String @id @default(uuid()) @db.Uuid

  /// Inclusive lower bound on completed orders in the calendar month.
  minOrders Int @map("min_orders")

  /// Inclusive upper bound. Null is the open-ended top band.
  maxOrders Int? @map("max_orders")

  /// Fraction, not percent: 0.08 is 8%.
  rate Decimal @db.Decimal(5, 4)

  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([minOrders])
  @@map("fleet_commission_tiers")
}

/// One calendar month of a fleet's trading, and the commission it owes.
///
/// Founder decision 2026-08-30: the whole month settles at the band the total
/// volume reaches — cross 5,000 orders and every order that month is charged
/// at the lower rate, not just the ones after the threshold. That cannot be
/// known until the month closes, so the running figures here are an estimate
/// until `settledAt`, and the rate that was finally applied is snapshotted the
/// way `Ride.platformCommissionRate` already snapshots its own.
model FleetCommissionPeriod {
  id      String @id @default(uuid()) @db.Uuid
  fleetId String @map("fleet_id") @db.Uuid

  /// First instant of the month, in Lagos time, stored as UTC.
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")

  /// Completed orders by this fleet's members in the period. This is what
  /// selects the band.
  orderCount Int @default(0) @map("order_count")

  /// What commission is charged on: the delivery fee for a delivery, the trip
  /// fare for a ride. Founder decisions 2026-08-30 — "8% of the delivery fee
  /// the system charges", then "rides should count too, use the trip fare".
  /// Never the basket the merchant sold; the merchant's own 10% is a separate
  /// arrangement, unaffected by who delivered.
  chargeableTotal Decimal @default(0) @map("chargeable_total") @db.Decimal(14, 2)

  /// Null until the month is settled. Snapshotted so a later edit to the tier
  /// table never rewrites a period that has already been invoiced.
  appliedRate      Decimal? @map("applied_rate") @db.Decimal(5, 4)
  commissionAmount Decimal? @map("commission_amount") @db.Decimal(14, 2)

  settledAt DateTime? @map("settled_at")
  settledBy String?   @map("settled_by") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)

  @@unique([fleetId, periodStart])
  @@index([settledAt])
  @@map("fleet_commission_periods")
}

// ── MKT-INT-001 Merchant Integration Platform ──────────────────────────────

/// MKT-INT-001 — Configured POS integration for a merchant. One merchant may
/// have multiple POS systems integrated (e.g., multiple branches), but each
/// integration is scoped to a single merchant and carries its own credentials.
/// Soft-delete only — archived_at is set when the integration is retired,
/// never destructively deleted.
model MerchantIntegration {
  id                     String    @id @default(uuid()) @db.Uuid
  /// The merchant this integration belongs to. Multi-tenant isolation scoping.
  merchantId             String    @map("merchant_id") @db.Uuid
  /// Human-readable name for this integration (e.g., "Branch A POS", "Main Inventory System")
  integrationName        String    @map("integration_name") @db.VarChar(150)
  /// POS system provider (e.g., "TALABAT", "JUMIA", "CUSTOM_POS")
  posProvider            String    @map("pos_provider") @db.VarChar(100)
  /// Integration status: ACTIVE (operational), PAUSED (temporarily disabled), or ARCHIVED (retired)
  status                 String    @default("ACTIVE") @map("status") @db.VarChar(50)
  /// Webhook endpoint where DrippleX sends events (order status, inventory updates, etc)
  webhookUrl             String?   @map("webhook_url") @db.VarChar(2048)
  /// Reference to the stored API credential
  credentialId           String?   @map("credential_id") @db.Uuid
  /// When was this integration last synchronized
  lastSyncedAt           DateTime? @map("last_synced_at")
  /// Soft-delete timestamp (null = active)
  archivedAt             DateTime? @map("archived_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  credential             IntegrationCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  logs                   IntegrationLog[]
  conflicts              IntegrationConflict[]
  catalogSyncJobs        CatalogSyncJob[]
  productSyncs           ProductSync[]
  inventoryUpdates       InventoryUpdate[]
  orderStatusUpdates     OrderStatusUpdate[]

  @@index([merchantId])
  @@index([status])
  @@index([archivedAt])
  @@map("merchant_integrations")
}

/// MKT-INT-001 — API credentials for POS→DrippleX authentication.
/// Stored hashed and encrypted. Scoped credentials with fine-grained permissions.
model IntegrationCredential {
  id              String    @id @default(uuid()) @db.Uuid
  integrationId   String    @map("integration_id") @db.Uuid
  /// API key (hashed), OAuth2 access token (encrypted), or other credential type
  credentialHash  String    @map("credential_hash") @db.Text
  /// Scopes: integrations:read, integrations:write, catalog:read, catalog:write, inventory:read, inventory:write, orders:read, orders:write
  scopes          String[]  @default([]) @map("scopes")
  /// When this credential expires (for OAuth2 tokens, etc). Null = doesn't expire.
  expiresAt       DateTime? @map("expires_at")
  /// When this credential was last rotated
  rotatedAt       DateTime? @map("rotated_at")
  /// Soft-delete timestamp
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  integrations    MerchantIntegration[]

  @@index([integrationId])
  @@index([expiresAt])
  @@index([archivedAt])
  @@map("integration_credentials")
}

/// MKT-INT-001 — Audit trail of all integration API activity.
/// Append-only: never updated or deleted. Every request/response logged for compliance.
model IntegrationLog {
  id              String    @id @default(uuid()) @db.Uuid
  integrationId   String    @map("integration_id") @db.Uuid
  /// API endpoint called (e.g., "/api/v1/catalog/sync", "/webhooks/order-status")
  endpoint        String    @map("endpoint") @db.VarChar(255)
  /// HTTP method (GET, POST, PUT, PATCH, DELETE)
  method          String    @map("method") @db.VarChar(10)
  /// Request body (truncated if very large)
  requestBody     String?   @map("request_body") @db.Text
  /// HTTP status code (200, 400, 401, 403, 500, etc)
  responseStatus  Int?      @map("response_status")
  /// Response body (truncated if very large)
  responseBody    String?   @map("response_body") @db.Text
  /// Error message if request failed
  errorMessage    String?   @map("error_message") @db.Text
  /// Caller's IP address
  ipAddress       String?   @map("ip_address") @db.VarChar(45)
  /// Correlation ID for tracing across distributed calls
  correlationId   String?   @map("correlation_id") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")

  integration     MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt(sort: Desc)])
  @@index([responseStatus])
  @@map("integration_logs")
}

/// MKT-INT-001 — Reconciliation conflicts that require manual review.
/// Records catalog mismatches, inventory discrepancies, order state conflicts.
model IntegrationConflict {
  id               String    @id @default(uuid()) @db.Uuid
  integrationId    String    @map("integration_id") @db.Uuid
  /// Type of conflict: CATALOG_PRICE_DIFF, INVENTORY_MISMATCH, ORDER_STATE_MISMATCH, PRODUCT_ARCHIVED, etc.
  conflictType     String    @map("conflict_type") @db.VarChar(100)
  /// ID of the source item (product, order, etc.)
  sourceId         String?   @map("source_id") @db.Uuid
  /// External identifier from POS system
  externalId       String?   @map("external_id") @db.VarChar(255)
  /// What DrippleX has
  dripplexValue    String?   @map("dripplex_value") @db.Text
  /// What the external system has
  externalValue    String?   @map("external_value") @db.Text
  /// Status: OPEN (needs review), RESOLVED (fixed), ESCALATED (requires ops intervention)
  status           String    @default("OPEN") @map("status") @db.VarChar(50)
  /// How the conflict was resolved (null if still OPEN)
  resolution       String?   @map("resolution") @db.VarChar(1000)
  /// When the conflict was resolved
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  integration      MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, status])
  @@index([conflictType])
  @@index([status])
  @@map("integration_conflicts")
}

/// MKT-INT-001 — Catalog synchronization job tracking.
/// Tracks batches of product syncs, their status, and outcomes.
model CatalogSyncJob {
  id            String    @id @default(uuid()) @db.Uuid
  integrationId String    @map("integration_id") @db.Uuid
  /// Job status: PENDING, IN_PROGRESS, COMPLETED, FAILED
  jobStatus     String    @default("PENDING") @map("job_status") @db.VarChar(50)
  /// Direction: POS_TO_DRIPPLEX (import) or DRIPPLEX_TO_POS (export)
  syncDirection String    @map("sync_direction") @db.VarChar(50)
  /// When the job started processing
  startedAt     DateTime? @map("started_at")
  /// When the job completed (null if still in progress)
  completedAt   DateTime? @map("completed_at")
  /// Number of products processed
  productCount  Int       @default(0) @map("product_count")
  /// Why the job failed (if applicable)
  failureReason String?   @map("failure_reason") @db.VarChar(500)
  createdAt     DateTime  @default(now()) @map("created_at")

  integration   MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, jobStatus])
  @@index([jobStatus])
  @@index([completedAt])
  @@map("catalog_sync_jobs")
}

/// MKT-INT-001 — SKU ↔ Product mapping.
/// Maps external POS SKU to internal DrippleX Product for catalog synchronization.
/// This is the bridge that enables product-level operations between systems.
model ProductSync {
  id                   String    @id @default(uuid()) @db.Uuid
  integrationId        String    @map("integration_id") @db.Uuid
  /// External SKU from the POS system (e.g., "SKU-12345")
  externalSku          String    @map("external_sku") @db.VarChar(100)
  /// Internal DrippleX Product ID
  productId            String?   @map("product_id") @db.Uuid
  /// When this mapping was last synchronized
  lastSyncedAt         DateTime? @map("last_synced_at")
  /// Status: ACTIVE (mapped and in use), ARCHIVED (soft-deleted), FAILED (mapping error)
  mappingStatus        String    @default("ACTIVE") @map("mapping_status") @db.VarChar(50)
  /// External catalog ID or collection this product belongs to (for reporting)
  externalCatalogId    String?   @map("external_catalog_id") @db.VarChar(100)
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  integration          MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  inventoryUpdates     InventoryUpdate[]

  @@unique([integrationId, externalSku])
  @@index([integrationId, mappingStatus])
  @@index([productId])
  @@map("product_syncs")
}

/// MKT-INT-001 — Inventory update event tracking.
/// Tracks webhook deliveries and API polls for inventory changes.
/// Uses idempotencyKey to prevent duplicate quantity updates.
model InventoryUpdate {
  id                String    @id @default(uuid()) @db.Uuid
  integrationId     String    @map("integration_id") @db.Uuid
  productSyncId     String    @map("product_sync_id") @db.Uuid
  /// External SKU (denormalized for query efficiency)
  externalSku       String    @map("external_sku") @db.VarChar(100)
  /// Previous quantity (before this update)
  previousQuantity  Int       @map("previous_quantity")
  /// New quantity (after this update)
  newQuantity       Int       @map("new_quantity")
  /// Whether this is a soft-delete (product archived in POS)
  isSoftDelete      Boolean   @default(false) @map("is_soft_delete")
  /// Source: WEBHOOK (pushed by POS) or API_POLL (pulled by DrippleX)
  sourceType        String    @map("source_type") @db.VarChar(50)
  /// Delivery status: PENDING, DELIVERED, FAILED
  deliveryStatus    String    @default("PENDING") @map("delivery_status") @db.VarChar(50)
  /// How many delivery attempts made
  attemptCount      Int       @default(0) @map("attempt_count")
  /// When the last delivery attempt was made
  lastAttemptAt     DateTime? @map("last_attempt_at")
  /// Idempotency key (UUID from external system) — prevents duplicate updates
  idempotencyKey    String    @map("idempotency_key") @db.VarChar(100)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  integration       MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  productSync       ProductSync         @relation(fields: [productSyncId], references: [id], onDelete: Cascade)

  @@unique([integrationId, idempotencyKey])
  @@index([integrationId, deliveryStatus])
  @@index([productSyncId])
  @@map("inventory_updates")
}

/// MKT-INT-001 — External order status updates from POS.
/// Tracks when POS notifies DrippleX of order state changes.
/// Uses idempotencyKey to prevent duplicate state transitions.
model OrderStatusUpdate {
  id                    String    @id @default(uuid()) @db.Uuid
  integrationId         String    @map("integration_id") @db.Uuid
  /// External order ID from POS system
  externalOrderId       String    @map("external_order_id") @db.VarChar(255)
  /// Internal DrippleX Order ID (may be null if not yet matched)
  internalOrderId       String?   @map("internal_order_id") @db.Uuid
  /// Previous order status
  previousStatus        String?   @map("previous_status") @db.VarChar(50)
  /// New order status
  newStatus             String    @map("new_status") @db.VarChar(50)
  /// Timestamp from the external system (for conflict detection)
  sourceTimestamp       DateTime  @map("source_timestamp")
  /// When DrippleX processed this update
  processedAt           DateTime? @map("processed_at")
  /// Reconciliation status: ACCEPTED (matched and processed), CONFLICT (state mismatch), PENDING (awaiting order creation)
  reconciliationStatus  String    @default("PENDING") @map("reconciliation_status") @db.VarChar(50)
  /// Idempotency key (prevents duplicate state transitions)
  idempotencyKey        String    @map("idempotency_key") @db.VarChar(100)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  integration           MerchantIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, idempotencyKey])
  @@index([integrationId, reconciliationStatus])
  @@index([internalOrderId])
  @@map("order_status_updates")
}
