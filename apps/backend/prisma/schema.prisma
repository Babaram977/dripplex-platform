  PUSH
  EMAIL
  SMS
  IN_APP
  WHATSAPP
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationType {
  ORDER_PLACED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RIDER_ASSIGNED
  DELIVERY_COMPLETED
  REFUND
  PROMOTION
  OTP
  PASSWORD_RESET
  WELCOME
  LOW_INVENTORY
  MERCHANT_APPROVAL
  RIDER_APPROVAL
  BACK_IN_STOCK
  PRICE_DROP
  GENERIC
  /// DPX-MOBILE-001 — a ride offered to a driver. Its own type rather than
  /// GENERIC so a driver can control ride-request alerts separately from
  /// everything else: NotificationPreference is keyed on (channel, type), so
  /// muting GENERIC would have muted the one notification they cannot afford
  /// to miss along with the ones they can.
  RIDE_OFFERED
  RIDE_DRIVER_ASSIGNED
  RIDE_DRIVER_ARRIVED
  RIDE_STARTED
  RIDE_COMPLETED
  REFERRAL_REDEEMED
  REFERRAL_REWARDED
  DRIVER_REFERRAL_PASSENGER_REGISTERED
  DRIVER_REFERRAL_PASSENGER_QUALIFIED
  DRIVER_REFERRAL_TIER_SILVER
  DRIVER_REFERRAL_TIER_GOLD
  DRIVER_REFERRAL_REWARD_APPROVED
  DRIVER_REFERRAL_REWARD_PAID
  PROMOTION_REDEEMED
  PROMOTION_EXPIRED
  CASHBACK_AWARDED
  WITHDRAWAL_REQUESTED
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_READY
  ORDER_DELAYED
  ORDER_COMPLETED
  DRIVER_SUPPORT_TICKET_UPDATED
  INCIDENT_REPORT_UPDATED
  SOS_ALERT_TRIGGERED
  SOS_ALERT_UPDATED
  SOS_ALERT_CUSTOMER_NOTICE
  /// Driver Slice 2 item 8 — Operational notifications: push versions of
  /// the advisory-only shift safety flags computed by
  /// DriverShiftService.getSummary() (see DriverShiftReminderSweepService).
  SHIFT_BREAK_REMINDER
  SHIFT_FATIGUE_WARNING
  SHIFT_DAILY_LIMIT_EXCEEDED
  /// A utility purchase finished and the customer has something to collect —
  /// an electricity token, an exam PIN, or simply the confirmation that the
  /// airtime landed. Separate from PAYMENT_SUCCESS because the payment
  /// succeeding and the *service* arriving are two different moments for
  /// utilities: money can be taken minutes or hours before Peyflex answers.
  UTILITY_PURCHASE_DELIVERED
  /// A utility purchase could not be completed and the money has been
  /// returned to the DrippleX Wallet (DPX-D4).
  UTILITY_PURCHASE_REVERSED
  /// The hotel accepted and the guest's 24 hours to pay have started
  /// (DPX-HOTEL-002). The one booking notification with a deadline attached:
  /// a guest who misses it loses the room to somebody else.
  BOOKING_ACCEPTED
  /// Paid in full, the room is assured, and the desk PIN has been issued.
  BOOKING_CONFIRMED
  /// The hotel declined. Nothing was ever charged.
  BOOKING_REJECTED
  /// The booking lapsed — either the hotel never answered, or the guest did
  /// not pay inside their 24 hours. Nothing was ever charged either way.
  BOOKING_EXPIRED
  /// DPX-MOBILE-002 — the other party to a live job is calling, right now.
  /// Its own type for the same reason RIDE_OFFERED has one: preferences are
  /// keyed on (channel, type), and a driver who silences ride requests has not
  /// asked to silence the passenger phoning them mid-trip. It is also what
  /// selects the Android channel, so a ring is separately tunable from an offer.
  /// The shortest-lived notification on the platform — CALL_RING_TIMEOUT_MS.
  CALL_INCOMING
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

/// Which module a notification belongs to — orthogonal to NotificationType
/// ("what happened?"). Deliberately not derived from type: several types
/// (PAYMENT_SUCCESS, PAYMENT_FAILED) are shared across categories (a ride
/// payment and a marketplace order payment both use PAYMENT_SUCCESS), so
/// category must be set explicitly by the caller, not inferred.
enum NotificationCategory {
  RIDE
  DELIVERY
  MARKETPLACE
  WALLET
  MERCHANT
  ADMIN
  SUPPORT
  EMERGENCY
  MARKETING
  SYSTEM
  SECURITY
  /// Airtime, data, electricity, cable, betting, education — the Peyflex hub.
  /// Not WALLET: the wallet may not be involved at all (card path), and a
  /// customer filtering their inbox for "my bill payments" is asking a
  /// different question from "my wallet movements".
  UTILITIES
  /// Hotel room bookings (DPX-HOTEL-002). Not MARKETPLACE: a booking is not an
  /// order — it has no cart, no delivery, and a guest looking for "my hotel
  /// bookings" is asking a different question from "my shopping".
  BOOKING
}

