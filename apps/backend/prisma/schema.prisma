  orderNumber         String                 @unique @map("order_number") @db.VarChar(40)
  status              OrderStatus            @default(PENDING)
  paymentStatus       PaymentStatus          @default(PENDING) @map("payment_status")
  paymentMethod       OrderPaymentMethod?    @map("payment_method")
  fulfillmentType     FulfillmentType        @map("fulfillment_type")
  subtotal            Decimal                @db.Decimal(12, 2)
  discount            Decimal                @default(0) @db.Decimal(12, 2)
  tax                 Decimal                @default(0) @db.Decimal(12, 2)
  deliveryFee         Decimal                @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total               Decimal                @db.Decimal(12, 2)
  couponCode          String?                @map("coupon_code") @db.VarChar(50)
  deliveryAddressId   String?                @map("delivery_address_id") @db.Uuid
  notes               String?                @db.VarChar(1000)
  currency            String                 @default("NGN") @db.VarChar(3)
  estimatedReadyAt    DateTime?              @map("estimated_ready_at")
  confirmedAt         DateTime?              @map("confirmed_at")
  readyAt             DateTime?              @map("ready_at")
  deliveredAt         DateTime?              @map("delivered_at")
  completedAt         DateTime?              @map("completed_at")
  cancelledAt         DateTime?              @map("cancelled_at")
  cancelledBy         OrderCancelledBy?      @map("cancelled_by")
  cancellationReason  String?                @map("cancellation_reason") @db.VarChar(500)
  refundedAt          DateTime?              @map("refunded_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  customer            User                   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items               OrderItem[]
  reservations        InventoryReservation[]
  paymentTransactions PaymentTransaction[]
  deliveryJobs        DeliveryJob[]
  disputes            OrderDispute[]
  paymentProofs       OrderPaymentProof[]
  settlement          OrderSettlement?

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  /// No @@index([orderNumber]) — `@unique` on the field already creates
  /// orders_order_number_key, and a unique index serves equality and range
  /// lookups exactly as a plain one would. The second index was never built by
  /// any migration; it was redundant, not missing.
  @@map("orders")
}

/// DPX-CORE-003 — mirrors RideProblemReport's shape (this codebase's
/// existing dispute/problem-report pattern) rather than inventing a new
/// one. Deliberately minimal: no photo evidence or moderation queue this
/// pass, see docs/MARKETPLACE-FOUNDATION.md's honest-limitations section.
model OrderDispute {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  raisedBy   String             @map("raised_by") @db.Uuid
  reason     String             @db.VarChar(1000)
  status     OrderDisputeStatus @default(OPEN)
  resolution String?            @db.VarChar(1000)
  resolvedBy String?            @map("resolved_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at")
  resolvedAt DateTime?          @map("resolved_at")
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("order_disputes")
}

/// DPX-ORDER-PROOF-001 — the customer's evidence that they made the bank
/// transfer on a MERCHANT_DIRECT order.
///
/// Founder decision (2026-08-17): "when an order is paid to merchant customer
/// should have an option to upload receipt of payment which will go to merchant
/// for confirmation and in case of dispute it can be referenced."
///
/// DrippleX never sees the money on a MERCHANT_DIRECT order — it lands in the
/// merchant's own account — so confirmation stays the merchant's word
/// (MerchantOrdersService.confirmPaymentReceived). This does not change that.
/// What it changes is that the customer's side of the story is now on file:
/// before this, a customer who had genuinely paid had nothing to point at.
///
/// Append-only on purpose. A row is never edited or deleted, so a dispute
/// raised later reads exactly what was submitted and when — an editable record
/// is worth nothing as evidence. A customer who uploaded the wrong image adds
/// another row rather than rewriting the first.
///
/// Receipts are financial documents: `receipt_url` lives in the PRIVATE bucket
/// (see PUBLIC_UPLOAD_FOLDERS — `payment-proofs` is deliberately absent) and is
/// only ever read through a short-lived signed GET.
model OrderPaymentProof {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  /// The customer who submitted it. Kept even though it is derivable from the
  /// order, so the audit trail survives any later change to order ownership.
  submittedBy String   @map("submitted_by") @db.Uuid
  receiptUrl  String   @map("receipt_url") @db.VarChar(2048)
  /// The bank's transfer reference, as the customer typed it. Optional: a
  /// screenshot alone is still evidence, and blocking on a field the customer
  /// cannot find would simply stop them submitting anything.
  reference   String?  @db.VarChar(100)
  /// What the customer says they sent. Not assumed equal to order.total — a
  /// mismatch is exactly the kind of thing a dispute needs to be able to see.
  amount      Decimal? @db.Decimal(12, 2)
  note        String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([submittedBy])
  @@map("order_payment_proofs")
}

model OrderItem {
  id            String          @id @default(uuid()) @db.Uuid
  orderId       String          @map("order_id") @db.Uuid
  productId     String          @map("product_id") @db.Uuid
  variantId     String?         @map("variant_id") @db.Uuid
