model Ride {
  id                       String                   @id @default(uuid()) @db.Uuid
  customerId               String                   @map("customer_id") @db.Uuid
  driverId                 String?                  @map("driver_id") @db.Uuid
  rideType                 RideType                 @map("ride_type")
  status                   RideStatus               @default(REQUESTED)
  pickupLatitude           Decimal                  @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude          Decimal                  @map("pickup_longitude") @db.Decimal(10, 7)
  pickupAddress            String?                  @map("pickup_address") @db.VarChar(500)
  dropoffLatitude          Decimal                  @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude         Decimal                  @map("dropoff_longitude") @db.Decimal(10, 7)
  dropoffAddress           String?                  @map("dropoff_address") @db.VarChar(500)
  estimatedDistanceMeters  Int?                     @map("estimated_distance_meters")
  estimatedDurationSeconds Int?                     @map("estimated_duration_seconds")
  baseFare                 Decimal                  @default(0) @map("base_fare") @db.Decimal(12, 2)
  distanceFare             Decimal                  @default(0) @map("distance_fare") @db.Decimal(12, 2)
  timeFare                 Decimal                  @default(0) @map("time_fare") @db.Decimal(12, 2)
  totalFare                Decimal                  @default(0) @map("total_fare") @db.Decimal(12, 2)
  paymentMethod            RidePaymentMethod?       @map("payment_method")
  paymentStatus            RidePaymentStatus        @default(PENDING) @map("payment_status")
  platformCommission       Decimal?                 @map("platform_commission") @db.Decimal(12, 2)
  driverEarning            Decimal?                 @map("driver_earning") @db.Decimal(12, 2)
  tipAmount                Decimal?                 @map("tip_amount") @db.Decimal(12, 2)
  requestedAt              DateTime                 @default(now()) @map("requested_at")
  assignedAt               DateTime?                @map("assigned_at")
  arrivedAt                DateTime?                @map("arrived_at")
  startedAt                DateTime?                @map("started_at")
  completedAt              DateTime?                @map("completed_at")
  cancelledAt              DateTime?                @map("cancelled_at")
  cancelledBy              RideCancelledBy?         @map("cancelled_by")
  cancellationReason       String?                  @map("cancellation_reason") @db.VarChar(500)
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  customer                 User                     @relation("RideCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driver                   User?                    @relation("RideDriver", fields: [driverId], references: [id], onDelete: SetNull)
  trackingPoints           RideTracking[]
  offers                   RideOffer[]
  paymentTransactions      RidePaymentTransaction[]
  ratings                  RideRating[]
  problemReports           RideProblemReport[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
  @@map("rides")
}

