  movements          StockMovement[]

  @@map("product_inventory")
}

enum StockMovementType {
  INCOMING
  OUTGOING
  RESERVED
  RELEASED
  ADJUSTMENT
}

/// DPX-CORE-003 — the append-only inventory audit trail the CAT-003
/// backlog item (docs/RELEASE-HISTORY.md) already called out as deferred
/// from the original catalog build. Every quantity change to
/// ProductInventory should have a corresponding row here.
model StockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  inventoryId   String            @map("inventory_id") @db.Uuid
  type          StockMovementType
  quantity      Int
  balanceAfter  Int               @map("balance_after")
  reason        String?           @db.VarChar(255)
  referenceType String?           @map("reference_type") @db.VarChar(50)
  referenceId   String?           @map("reference_id") @db.Uuid
  actorUserId   String?           @map("actor_user_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")
  inventory     ProductInventory  @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("stock_movements")
}

model Cart {
