enum WalletTransactionType {
  CREDIT
  DEBIT
  REFUND
  SETTLEMENT
  CASHBACK
  WITHDRAWAL
  TRANSFER
  /// Money moved out of `availableBalance` and into `pendingBalance` — set
  /// aside for something that has not happened yet, and NOT taken. Every
  /// HOLD is terminated by exactly one HOLD_COMMIT or HOLD_RELEASE.
  HOLD
  /// The held money is now genuinely taken. `pendingBalance` falls;
  /// `availableBalance` does not move, because the HOLD already reduced it.
  HOLD_COMMIT
  /// The hold is given back. `pendingBalance` falls and `availableBalance`
  /// rises by the same amount, returning the wallet to where it started.
  HOLD_RELEASE
}

