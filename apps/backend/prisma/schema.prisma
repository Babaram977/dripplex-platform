  deliveryJobs        DeliveryJob[]
  disputes            OrderDispute[]

  @@index([customerId])
  @@index([merchantId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

/// DPX-CORE-003 — mirrors RideProblemReport's shape (this codebase's
/// existing dispute/problem-report pattern) rather than inventing a new
/// one. Deliberately minimal: no photo evidence or moderation queue this
/// pass, see docs/MARKETPLACE-FOUNDATION.md's honest-limitations section.
model OrderDispute {
  id         String             @id @default(uuid()) @db.Uuid
  orderId    String             @map("order_id") @db.Uuid
  raisedBy   String             @map("raised_by") @db.Uuid
  reason     String             @db.VarChar(1000)
  status     OrderDisputeStatus @default(OPEN)
  resolution String?            @db.VarChar(1000)
  resolvedBy String?            @map("resolved_by") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at")
  resolvedAt DateTime?          @map("resolved_at")
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("order_disputes")
}

model OrderItem {
