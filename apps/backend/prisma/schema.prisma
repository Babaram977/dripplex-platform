generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum RegistrationChannel {
  CUSTOMER_WEB
  MERCHANT_PORTAL
  RIDER_PORTAL
  DRIVER_PORTAL
  OPS_INVITE
  ADMIN_INVITE
  SEED
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum IdentityVerificationType {
  EMAIL
  PHONE
}

enum MerchantStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  SUBMITTED
  ACTIVE
  SUSPENDED
}

enum BusinessVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LIMITED_LIABILITY
  CORPORATION
  OTHER
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  CAC_CERTIFICATE
  BUSINESS_REGISTRATION
  VEHICLE_REGISTRATION
  GUARANTOR_ID
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  LOCKED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MONIEPOINT
  OPAY
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum AssignmentMethod {
  AUTO
  MANUAL
}

enum ProofType {
  PHOTO
  OTP
  SIGNATURE
  PHOTO_AND_OTP
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                      String                   @id @default(uuid()) @db.Uuid
  email                   String                   @unique @db.Citext
  phone                   String?                  @unique @db.VarChar(32)
  passwordHash            String                   @map("password_hash")
  firstName               String                   @map("first_name") @db.VarChar(100)
  lastName                String                   @map("last_name") @db.VarChar(100)
  status                  UserStatus               @default(PENDING_VERIFICATION)
  registrationChannel     RegistrationChannel?     @map("registration_channel")
  emailVerifiedAt         DateTime?                @map("email_verified_at")
  phoneVerifiedAt         DateTime?                @map("phone_verified_at")
  lastLoginAt             DateTime?                @map("last_login_at")
  lastActiveAt            DateTime?                @map("last_active_at")
  passwordChangedAt       DateTime?                @map("password_changed_at")
  blockedAt               DateTime?                @map("blocked_at")
  blockedReason           String?                  @map("blocked_reason") @db.VarChar(500)
  roles                   UserRole[]
  authSessions            AuthSession[]
  passwordResetTokens     PasswordResetToken[]
  identityVerifications   IdentityVerification[]
  customerProfile         CustomerProfile?
  merchantProfile         MerchantProfile?
  riderProfile            RiderProfile?
  driverProfile           DriverProfile?
  businesses              Business[]
  merchantKycs            MerchantKyc[]
  bankAccounts            BankAccount[]
  customerAddresses       CustomerAddress[]
  carts                   Cart[]
  orders                  Order[]
  paymentTransactions     PaymentTransaction[]
  deliveryJobsAsCustomer  DeliveryJob[]            @relation("DeliveryCustomer")
  deliveryJobsAsMerchant  DeliveryJob[]            @relation("DeliveryMerchant")
  deliveryJobsAsRider     DeliveryJob[]            @relation("DeliveryRider")
  riderAvailability       RiderAvailability?
  ridesAsCustomer         Ride[]                   @relation("RideCustomer")
  ridesAsDriver           Ride[]                   @relation("RideDriver")
  driverAvailability      DriverAvailability?
  driverKycDocuments      DriverKyc[]
  rideOffers              RideOffer[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  deviceTokens            DeviceToken[]
  searchQueryLogs         SearchQueryLog[]
  recentSearches          RecentSearch[]
  reviews                 Review[]                 @relation("ReviewAuthor")
  reviewVotes             ReviewVote[]
  reviewReports           ReviewReport[]           @relation("ReviewReporter")
  wishlists               Wishlist[]               @relation("WishlistCustomer")
  promotionRedemptions    PromotionRedemption[]
  loyaltyAccount          LoyaltyAccount?
  userAchievements        UserAchievement[]
  cmsContentVersions      CmsContentVersion[]      @relation("CmsContentVersionCreator")
  fraudSignals            FraudSignal[]            @relation("FraudSignalUser")
  fraudReviews            FraudSignal[]            @relation("FraudSignalReviewer")
  auditLogs               AuditLog[]
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")

  @@index([status])
  @@index([deletedAt])
  @@index([registrationChannel])
  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?          @db.VarChar(500)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model AuthSession {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  refreshTokenHash String?             @map("refresh_token_hash") @db.VarChar(64)
  portal           RegistrationChannel @map("portal")
  deviceId         String?             @map("device_id") @db.VarChar(128)
  deviceName       String?             @map("device_name") @db.VarChar(255)
  ipAddress        String?             @map("ip_address") @db.VarChar(45)
  userAgent        String?             @map("user_agent") @db.VarChar(512)
  rememberMe       Boolean             @default(false) @map("remember_me")
  expiresAt        DateTime            @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  lastSeenAt       DateTime            @default(now()) @map("last_seen_at")
  lastActiveAt     DateTime            @default(now()) @map("last_active_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([userId, revokedAt])
  @@index([portal])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerification {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  type         IdentityVerificationType
  tokenHash    String?                  @unique @map("token_hash") @db.VarChar(64)
  otpHash      String?                  @map("otp_hash") @db.VarChar(64)
  expiresAt    DateTime                 @map("expires_at")
  consumedAt   DateTime?                @map("consumed_at")
  attemptCount Int                      @default(0) @map("attempt_count")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, type, consumedAt])
  @@index([otpHash])
  @@index([expiresAt])
  @@map("identity_verifications")
}

model CustomerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  locale    String    @default("en_NG") @db.VarChar(10)
  timezone  String    @default("Africa/Lagos") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("customer_profiles")
}

model CustomerAddress {
  id            String       @id @default(uuid()) @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  label         AddressLabel
  recipientName String       @map("recipient_name") @db.VarChar(150)
  phone         String       @db.VarChar(32)
  addressLine1  String       @map("address_line1") @db.VarChar(255)
  addressLine2  String?      @map("address_line2") @db.VarChar(255)
  landmark      String?      @db.VarChar(255)
  city          String       @db.VarChar(100)
  state         String       @db.VarChar(100)
  country       String       @db.VarChar(100)
  postalCode    String?      @map("postal_code") @db.VarChar(20)
  latitude      Decimal      @db.Decimal(10, 7)
  longitude     Decimal      @db.Decimal(10, 7)
  isDefault     Boolean      @default(false) @map("is_default")
  isActive      Boolean      @default(true) @map("is_active")
  verifiedAt    DateTime?    @map("verified_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  customer      User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([latitude])
  @@index([longitude])
  @@index([isDefault])
  @@index([customerId, deletedAt])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model MerchantProfile {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  status         MerchantStatus      @default(PENDING)
  isApproved     Boolean             @default(false) @map("is_approved")
  approvedAt     DateTime?           @map("approved_at")
  approvedBy     String?             @map("approved_by") @db.Uuid
  rejectedReason String?             @map("rejected_reason") @db.VarChar(1000)
  suspendedAt    DateTime?           @map("suspended_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding     MerchantOnboarding?
  products       Product[]

  @@index([status])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("merchant_profiles")
}

model Business {
  id                 String                     @id @default(uuid()) @db.Uuid
  merchantId         String                     @unique @map("merchant_id") @db.Uuid
  businessName       String                     @map("business_name") @db.VarChar(150)
  businessType       BusinessType               @map("business_type")
  registrationNumber String                     @unique @map("registration_number") @db.VarChar(100)
  taxNumber          String?                    @map("tax_number") @db.VarChar(100)
  description        String?                    @db.VarChar(2000)
  email              String                     @db.Citext
  phone              String                     @db.VarChar(32)
  country            String                     @db.VarChar(100)
  state              String                     @db.VarChar(100)
  city               String                     @db.VarChar(100)
  address            String                     @db.VarChar(500)
  latitude           Decimal                    @db.Decimal(10, 7)
  longitude          Decimal                    @db.Decimal(10, 7)
  logoUrl            String?                    @map("logo_url") @db.VarChar(2048)
  coverPhotoUrl      String?                    @map("cover_photo_url") @db.VarChar(2048)
  operatingHours     Json?                      @map("operating_hours")
  status             BusinessStatus             @default(DRAFT)
  verificationStatus BusinessVerificationStatus @default(PENDING) @map("verification_status")
  approvedBy         String?                    @map("approved_by") @db.Uuid
  approvedAt         DateTime?                  @map("approved_at")
  rejectedReason     String?                    @map("rejected_reason") @db.VarChar(1000)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  merchant           User                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kycDocuments       MerchantKyc[]

  @@index([status])
  @@index([verificationStatus])
  @@index([country, state])
  @@index([createdAt])
  @@map("businesses")
}

model MerchantKyc {
  id                 String                @id @default(uuid()) @db.Uuid
  merchantId         String                @map("merchant_id") @db.Uuid
  businessId         String                @map("business_id") @db.Uuid
  documentType       KycDocumentType       @map("document_type")
  documentNumber     String                @map("document_number") @db.VarChar(100)
  frontImage         String                @map("front_image") @db.VarChar(2048)
  backImage          String?               @map("back_image") @db.VarChar(2048)
  selfieImage        String?               @map("selfie_image") @db.VarChar(2048)
  verificationStatus KycVerificationStatus @default(PENDING) @map("verification_status")
  reviewedBy         String?               @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at")
  remarks            String?               @db.VarChar(1000)
  createdAt          DateTime              @default(now()) @map("created_at")
  merchant           User                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([businessId])
  @@index([verificationStatus])
  @@index([merchantId, verificationStatus])
  @@map("merchant_kyc")
}

model BankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  bankName      String    @map("bank_name") @db.VarChar(150)
  accountName   String    @map("account_name") @db.VarChar(150)
  accountNumber String    @map("account_number") @db.VarChar(20)
  currency      String    @default("NGN") @db.VarChar(3)
  isDefault     Boolean   @default(false) @map("is_default")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  merchant      User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, accountNumber])
  @@index([merchantId])
  @@index([merchantId, isDefault])
  @@map("bank_accounts")
}

model RiderProfile {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @unique @map("user_id") @db.Uuid
  isApproved Boolean          @default(false) @map("is_approved")
  approvedAt DateTime?        @map("approved_at")
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  deletedAt  DateTime?        @map("deleted_at")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding RiderOnboarding?

  @@index([isApproved])
  @@index([deletedAt])
  @@map("rider_profiles")
}

model DriverProfile {
  id             String            @id @default(uuid()) @db.Uuid
  userId         String            @unique @map("user_id") @db.Uuid
  status         DriverStatus      @default(PENDING)
  isApproved     Boolean           @default(false) @map("is_approved")
  approvedAt     DateTime?         @map("approved_at")
  approvedBy     String?           @map("approved_by") @db.Uuid
  rejectedReason String?           @map("rejected_reason") @db.VarChar(1000)
  suspendedAt    DateTime?         @map("suspended_at")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  deletedAt      DateTime?         @map("deleted_at")
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding     DriverOnboarding?

  @@index([status])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("driver_profiles")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String   @db.VarChar(150)
  resource   String?  @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model MerchantOnboarding {
  id                String           @id @default(uuid()) @db.Uuid
  merchantProfileId String           @unique @map("merchant_profile_id") @db.Uuid
  status            OnboardingStatus @default(DRAFT)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  merchantProfile   MerchantProfile  @relation(fields: [merchantProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("merchant_onboarding")
}

model RiderOnboarding {
  id             String           @id @default(uuid()) @db.Uuid
  riderProfileId String           @unique @map("rider_profile_id") @db.Uuid
  status         OnboardingStatus @default(DRAFT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  riderProfile   RiderProfile     @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("rider_onboarding")
}

model DriverOnboarding {
  id              String           @id @default(uuid()) @db.Uuid
  driverProfileId String           @unique @map("driver_profile_id") @db.Uuid
  status          OnboardingStatus @default(DRAFT)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  driverProfile   DriverProfile    @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("driver_onboarding")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(140)
  description String?    @db.VarChar(1000)
  parentId    String?    @map("parent_id") @db.Uuid
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model Brand {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(120)
  slug      String    @unique @db.VarChar(140)
  logoUrl   String?   @map("logo_url") @db.VarChar(2048)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]

  @@index([isActive])
  @@map("brands")
}

model Product {
  id          String            @id @default(uuid()) @db.Uuid
  merchantId  String            @map("merchant_id") @db.Uuid
  categoryId  String?           @map("category_id") @db.Uuid
  brandId     String?           @map("brand_id") @db.Uuid
  name        String            @db.VarChar(255)
  slug        String            @db.VarChar(280)
  description String?           @db.VarChar(4000)
  basePrice   Decimal           @map("base_price") @db.Decimal(12, 2)
  currency    String            @default("NGN") @db.VarChar(3)
  sku         String?           @db.VarChar(100)
  status      ProductStatus     @default(DRAFT)
  isFeatured  Boolean           @default(false) @map("is_featured")
  isDeleted   Boolean           @default(false) @map("is_deleted")
  publishedAt DateTime?         @map("published_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  merchant    MerchantProfile   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand       Brand?            @relation(fields: [brandId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    ProductVariant[]
  inventory   ProductInventory?
  cartItems   CartItem[]
  orderItems  OrderItem[]

  @@unique([merchantId, slug])
  @@index([merchantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isDeleted])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(2048)
  altText   String?  @map("alt_text") @db.VarChar(255)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id            String      @id @default(uuid()) @db.Uuid
  productId     String      @map("product_id") @db.Uuid
  name          String      @db.VarChar(120)
  sku           String?     @db.VarChar(100)
  priceOverride Decimal?    @map("price_override") @db.Decimal(12, 2)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]

