  proofs                   DeliveryProof[]

  @@index([riderId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("delivery_jobs")
}

model DeliveryTracking {
  id            String      @id @default(uuid()) @db.Uuid
  deliveryJobId String      @map("delivery_job_id") @db.Uuid
  latitude      Decimal     @db.Decimal(10, 7)
  longitude     Decimal     @db.Decimal(10, 7)
