model Order {
  id                  String                 @id @default(uuid()) @db.Uuid
  customerId          String                 @map("customer_id") @db.Uuid
  merchantId          String                 @map("merchant_id") @db.Uuid
  cartId              String?                @map("cart_id") @db.Uuid
  orderNumber         String                 @unique @map("order_number") @db.VarChar(40)
  status              OrderStatus            @default(PENDING)
  paymentStatus       PaymentStatus          @default(PENDING) @map("payment_status")
  paymentMethod       OrderPaymentMethod?    @map("payment_method")
  fulfillmentType     FulfillmentType        @map("fulfillment_type")
  subtotal            Decimal                @db.Decimal(12, 2)
  discount            Decimal                @default(0) @db.Decimal(12, 2)
  tax                 Decimal                @default(0) @db.Decimal(12, 2)
  deliveryFee         Decimal                @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  total               Decimal                @db.Decimal(12, 2)
  couponCode          String?                @map("coupon_code") @db.VarChar(50)
  deliveryAddressId   String?                @map("delivery_address_id") @db.Uuid
  notes               String?                @db.VarChar(1000)
  currency            String                 @default("NGN") @db.VarChar(3)
  estimatedReadyAt    DateTime?              @map("estimated_ready_at")
