  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model InventoryReservation {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @map("order_id") @db.Uuid
  productId  String    @map("product_id") @db.Uuid
  variantId  String?   @map("variant_id") @db.Uuid
  quantity   Int
  expiresAt  DateTime  @map("expires_at")
  releasedAt DateTime? @map("released_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@index([expiresAt])
  @@index([releasedAt])
  @@map("inventory_reservations")
}

model PaymentTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  orderId               String            @map("order_id") @db.Uuid
  customerId            String            @map("customer_id") @db.Uuid
  merchantId            String            @map("merchant_id") @db.Uuid
  provider              PaymentProvider
  providerReference     String            @unique @map("provider_reference") @db.VarChar(100)
  providerTransactionId String?           @map("provider_transaction_id") @db.VarChar(100)
  status                TransactionStatus @default(PENDING)
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("NGN") @db.VarChar(3)
  authorizationUrl      String?           @map("authorization_url") @db.VarChar(2048)
  accessCode            String?           @map("access_code") @db.VarChar(100)
  gatewayResponse       Json?             @map("gateway_response")
  paidAt                DateTime?         @map("paid_at")
  verifiedAt            DateTime?         @map("verified_at")
  metadata              Json              @default("{}")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer              User              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerReference])
  @@index([providerTransactionId])
  @@index([status])
  @@index([customerId])
  @@index([merchantId])
  @@map("payment_transactions")
}

/// DPX-MERCHANT-002 — the platform-wide merchant commission rate,
/// admin-configurable rather than hardcoded (unlike Ride's
/// RIDE_PLATFORM_COMMISSION_RATE constant). Singleton row, read once per
/// settlement and snapshotted into OrderSettlement.commissionRate — a
/// later change here never touches an already-created settlement.
model MerchantCommissionSetting {
  id             String   @id @default(uuid()) @db.Uuid
  commissionRate Decimal  @default(0.10) @map("commission_rate") @db.Decimal(5, 4)
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("merchant_commission_settings")
}

/// DPX-LAUNCH — the Ops-configurable platform commission rate applied to
/// ride settlement (default 10%). A single row, read at each ride
/// settlement and editable by an administrator without a redeploy — same
/// pattern as MerchantCommissionSetting / DriverSecuritySettings. The DB
/// row is the source of truth from first creation onward;
/// DEFAULT_PLATFORM_COMMISSION_RATE only seeds the row's initial value.
///
/// Changing the rate here never rewrites an already-settled ride — each
/// ride snapshots the rate it settled at into Ride.platformCommissionRate
/// (and the resulting platformCommission/driverEarning amounts), so
/// refunds/reversals always use the rate that applied when the ride settled.
/// Ops-editable fare table, one row per ride type.
///
/// Fares used to live in RIDE_FARE_RATES, a hardcoded constant that still
/// carried its own warning that it was "not a founder-approved fare table".
/// Changing a price meant a code change and a deploy. The row is the source of
/// truth from first creation onward; the constant only seeds it.
///
/// A ride snapshots the amounts it was priced at, so editing this never
/// re-prices a trip that has already happened.
model RideFareRate {
  rideType RideType @id @map("ride_type")

  baseFare      Decimal @default(0) @map("base_fare") @db.Decimal(12, 2)
  perKmRate     Decimal @default(0) @map("per_km_rate") @db.Decimal(12, 2)
  perMinuteRate Decimal @default(0) @map("per_minute_rate") @db.Decimal(12, 2)

  /// Floor under the computed fare, not an addition — a short hop that prices
  /// below this is charged this instead, and longer trips are unaffected.
  /// Founder-locked at ₦1,500 (2026-08-16); every type is seeded with that
  /// figure, and the per-type column exists so a rate can be varied later
  /// without another migration.
  minimumFare Decimal @default(0) @map("minimum_fare") @db.Decimal(12, 2)

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ride_fare_rates")
}

/// A named circle where trips cost more — the airport being the case that
/// prompted it.
///
/// Deliberately a centre plus a radius rather than a polygon: an operator can
/// set one up from a map pin and a distance without a GIS tool, and it is the
/// same maths dispatch already runs. Polygons can come later if a zone ever
/// needs a shape a circle cannot express.
model RideSurchargeZone {
  id   String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)

  latitude     Decimal @db.Decimal(10, 7)
  longitude    Decimal @db.Decimal(10, 7)
  radiusMeters Int     @map("radius_meters")

  surchargeType RideSurchargeType    @map("surcharge_type")
  /// Naira when surchargeType is FLAT; a factor (1.25 = a quarter more) when
  /// it is MULTIPLIER.
  amount        Decimal              @db.Decimal(12, 4)
  appliesTo     RideSurchargeTrigger @default(EITHER) @map("applies_to")

  /// Deactivating keeps the zone and its name available to rides that already
  /// reference it, which deleting would not.
  active Boolean @default(true)

  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  rides Ride[]

  @@index([active])
  @@map("ride_surcharge_zones")
}

model PlatformCommissionSetting {
  id             String   @id @default(uuid()) @db.Uuid
  commissionRate Decimal  @default(0.10) @map("commission_rate") @db.Decimal(5, 4)
  updatedBy      String?  @map("updated_by") @db.Uuid
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("platform_commission_settings")
}

enum OrderSettlementStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

/// DPX-MERCHANT-002 — one row per settled Order, created once
/// (orderId is the exactly-once guard) on ORDER_COMPLETED and credited to
/// the merchant's wallet via the existing Wallet/Ledger architecture. See
/// docs/DPX-MERCHANT-002-SETTLEMENT-DESIGN.md.
model OrderSettlement {
  id                    String                @id @default(uuid()) @db.Uuid
  orderId               String                @unique @map("order_id") @db.Uuid
  merchantId            String                @map("merchant_id") @db.Uuid
  status                OrderSettlementStatus @default(PENDING)
  grossAmount           Decimal               @map("gross_amount") @db.Decimal(12, 2)
  commissionRate        Decimal               @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount      Decimal               @map("commission_amount") @db.Decimal(12, 2)
  merchantAmount        Decimal               @map("merchant_amount") @db.Decimal(12, 2)
  currency              String                @default("NGN") @db.VarChar(3)
  walletLedgerEntryId   String?               @map("wallet_ledger_entry_id") @db.Uuid
  failureReason         String?               @map("failure_reason") @db.VarChar(1000)
  reversedAt            DateTime?             @map("reversed_at")
  reversalReason        String?               @map("reversal_reason") @db.VarChar(1000)
  reversalLedgerEntryId String?               @map("reversal_ledger_entry_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  order                 Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([merchantId])
  @@index([status])
  @@map("order_settlements")
}

/// DPX-COMMERCIAL-001 — which real owner a CommissionAccount/
/// CommercialCreditSetting belongs to. Mirrors WalletOwnerType's existing
/// MERCHANT/RIDER/DRIVER split (Rider = Marketplace delivery courier,
/// Driver = Ride-hailing driver — already separate identities/wallets in
/// this codebase) rather than inventing a new taxonomy.
enum CommissionOwnerType {
  MERCHANT
  DRIVER
  RIDER
}

enum CommissionEntryType {
  ACCRUAL
  PAYMENT
  ADJUSTMENT
}

/// DPX-COMMERCIAL-001 — the liability side of the commercial engine,
/// deliberately separate from Wallet (an asset-only ledger that hard-blocks
/// going negative). One row per real owner: outstandingBalance is what they
/// owe DrippleX for offline-settled commission (Marketplace "Pay to
/// Merchant" / Cash on Delivery, Ride cash) that hasn't been paid down yet.
/// creditLimit is snapshotted from CommercialCreditSetting at
/// account-creation time and re-synced whenever accrue()/recordPayment()
/// runs, so a global limit change is prospective — it takes effect on the
/// next event that touches the account, not retroactively (same principle
/// as MerchantCommissionSetting.commissionRate snapshotting into each
/// OrderSettlement). See docs/DPX-COMMERCIAL-001-REVENUE-SETTLEMENT-CREDIT-POLICY.md.
model CommissionAccount {
  id                 String                  @id @default(uuid()) @db.Uuid
  ownerType          CommissionOwnerType     @map("owner_type")
  ownerId            String                  @map("owner_id") @db.Uuid
  outstandingBalance Decimal                 @default(0) @map("outstanding_balance") @db.Decimal(14, 2)
  /// The limit actually in force. Materialised so every read is one query;
  /// kept in sync from negotiatedCreditLimit, or from the owner-type default
  /// when no limit has been negotiated.
  creditLimit        Decimal                 @map("credit_limit") @db.Decimal(14, 2)
  /// A limit agreed with this partner individually (founder decision,
  /// 2026-08-20: "limit should be individually set to each merchant because
  /// of business difference and it should be negotiated and agreed by
  /// DrippleX and merchant"). A furniture shop selling ₦650,000 pieces and a
  /// food vendor selling ₦2,000 plates cannot share one ceiling.
  ///
  /// Null means no agreement exists yet and the owner-type default applies —
  /// which is also what makes the platform default meaningful rather than
  /// something that silently overwrites a negotiated figure.
  negotiatedCreditLimit Decimal?             @map("negotiated_credit_limit") @db.Decimal(14, 2)
  /// Who agreed it, when, and on what terms. A negotiated limit is a
  /// commercial commitment, so it carries its own record rather than living
  /// only in the audit log.
  negotiatedBy       String?                 @map("negotiated_by") @db.Uuid
  negotiatedAt       DateTime?               @map("negotiated_at")
  negotiationNote    String?                 @map("negotiation_note") @db.VarChar(500)
  blocked            Boolean                 @default(false)
  blockedAt          DateTime?               @map("blocked_at")
  /// Optimistic-concurrency guard on outstandingBalance updates, same
  /// pattern as Wallet.version — a conditional updateMany() keyed on both
  /// id and version, incremented on every accrue()/recordPayment() write.
  version            Int                     @default(0)
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  ledgerEntries      CommissionLedgerEntry[]

  @@unique([ownerType, ownerId])
  @@index([ownerType])
  @@index([blocked])
  @@map("commission_accounts")
}

/// Mirrors WalletLedgerEntry's shape deliberately (same pattern the
/// codebase already trusts) including the (accountId, referenceType,
/// referenceId) uniqueness constraint that gives ACCRUAL entries an
/// exactly-once guard when tied to a real order/ride/delivery-job
/// reference; manual PAYMENT entries with no reference are unconstrained
/// (Postgres treats NULL as distinct in a unique index, so multiple
/// no-reference rows are allowed, same as WalletLedgerEntry).
model CommissionLedgerEntry {
  id            String              @id @default(uuid()) @db.Uuid
  accountId     String              @map("account_id") @db.Uuid
  type          CommissionEntryType
  amount        Decimal             @db.Decimal(14, 2)
  balanceAfter  Decimal             @map("balance_after") @db.Decimal(14, 2)
  referenceType String?             @map("reference_type") @db.VarChar(100)
  referenceId   String?             @map("reference_id") @db.Uuid
  description   String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @map("created_at")
  account       CommissionAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, referenceType, referenceId], map: "commission_ledger_entries_account_reference_key")
  @@index([accountId])
  @@index([accountId, createdAt])
  @@index([type])
  @@index([referenceType, referenceId])
  @@map("commission_ledger_entries")
}

/// DPX-COMMERCIAL-001 — the admin-configurable commission credit limit,
/// one row per owner type (not per individual merchant/driver — an
/// admin can widen this later to a per-account override, not built here).
/// Same get-or-create-singleton + audit-logged-update pattern as
/// MerchantCommissionSetting/DriverSecuritySettings; DEFAULT_MERCHANT_
/// CREDIT_LIMIT/DEFAULT_DRIVER_CREDIT_LIMIT are seed-only constants, never
/// hardcoded in service logic — the DB row is the source of truth from
/// first creation onward.
model CommercialCreditSetting {
  id          String              @id @default(uuid()) @db.Uuid
  ownerType   CommissionOwnerType @unique @map("owner_type")
  creditLimit Decimal             @map("credit_limit") @db.Decimal(14, 2)
  updatedBy   String?             @map("updated_by") @db.Uuid
  updatedAt   DateTime            @updatedAt @map("updated_at")
  createdAt   DateTime            @default(now()) @map("created_at")

  @@map("commercial_credit_settings")
}

model DeliveryJob {
  id                       String             @id @default(uuid()) @db.Uuid
  orderId                  String             @unique @map("order_id") @db.Uuid
  riderId                  String?            @map("rider_id") @db.Uuid
  merchantId               String             @map("merchant_id") @db.Uuid
  customerId               String             @map("customer_id") @db.Uuid
  assignmentMethod         AssignmentMethod   @default(AUTO) @map("assignment_method")
  status                   DeliveryStatus     @default(PENDING)
  pickupLatitude           Decimal            @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude          Decimal            @map("pickup_longitude") @db.Decimal(10, 7)
  dropoffLatitude          Decimal            @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude         Decimal            @map("dropoff_longitude") @db.Decimal(10, 7)
  estimatedDistanceMeters  Int?               @map("estimated_distance_meters")
  estimatedDurationSeconds Int?               @map("estimated_duration_seconds")
  deliveryFee              Decimal            @default(0) @map("delivery_fee") @db.Decimal(12, 2)
  assignedAt               DateTime?          @map("assigned_at")
  acceptedAt               DateTime?          @map("accepted_at")
  pickedUpAt               DateTime?          @map("picked_up_at")
  arrivedAt                DateTime?          @map("arrived_at")
  deliveredAt              DateTime?          @map("delivered_at")
  failedAt                 DateTime?          @map("failed_at")
  cancelledAt              DateTime?          @map("cancelled_at")
  returnedAt               DateTime?          @map("returned_at")
  cancellationReason       String?            @map("cancellation_reason") @db.VarChar(500)
  /// DPX-COMMERCIAL-001 Slice 3 — the rider's own confirmation of cash
  /// physically collected from the customer (only ever set for
  /// paymentMethod=CASH orders). Independent of, and not used to compute,
  /// the merchant's commission accrual (still derived from order.subtotal,
  /// the same deterministic source every other settlement path uses) — a
  /// mismatch between this figure and the order total is a reconciliation
  /// signal for ops, not a live commercial-math input. See
  /// docs/DPX-COMMERCIAL-001-SLICE-3-COD-CORRECTION.md §5.6.
  cashCollectedAmount      Decimal?           @map("cash_collected_amount") @db.Decimal(12, 2)
  cashConfirmedAt          DateTime?          @map("cash_confirmed_at")
  /// DPX-RIDER-006 — what the rider earned from this delivery and what
  /// DrippleX kept, both derived from deliveryFee at settlement time and
  /// frozen here. Founder decision 2026-08-15: the rider earns the delivery
  /// fee minus the platform commission rate (10% by default, Ops-adjustable).
  /// Null until settled. Before this, a completed delivery paid the rider
  /// nothing at all — the fee was collected and attributed to no one.
  riderEarning             Decimal?           @map("rider_earning") @db.Decimal(12, 2)
  platformCommission       Decimal?           @map("platform_commission") @db.Decimal(12, 2)
  /// Set once, by the settlement path. Its presence is the idempotency guard:
  /// a re-fired completion event must never pay a rider twice.
  settledAt                DateTime?          @map("settled_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  order                    Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider                    User?              @relation("DeliveryRider", fields: [riderId], references: [id], onDelete: SetNull)
  merchant                 User               @relation("DeliveryMerchant", fields: [merchantId], references: [id], onDelete: Cascade)
  customer                 User               @relation("DeliveryCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  trackingPoints           DeliveryTracking[]
  proofs                   DeliveryProof[]

  @@index([riderId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@map("delivery_jobs")
}

model DeliveryTracking {
  id            String      @id @default(uuid()) @db.Uuid
  deliveryJobId String      @map("delivery_job_id") @db.Uuid
  latitude      Decimal     @db.Decimal(10, 7)
  longitude     Decimal     @db.Decimal(10, 7)
  heading       Float?
  speed         Float?
  accuracy      Float?
  createdAt     DateTime    @default(now()) @map("created_at")
  deliveryJob   DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)

  @@index([deliveryJobId])
  @@index([deliveryJobId, createdAt])
  @@map("delivery_tracking")
}

model DeliveryProof {
  id            String      @id @default(uuid()) @db.Uuid
  deliveryJobId String      @map("delivery_job_id") @db.Uuid
  proofType     ProofType   @map("proof_type")
  photoUrl      String?     @map("photo_url") @db.VarChar(2048)
  otp           String?     @db.VarChar(12)
  signatureUrl  String?     @map("signature_url") @db.VarChar(2048)
  notes         String?     @db.VarChar(1000)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  deliveryJob   DeliveryJob @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)

  @@index([deliveryJobId])
  @@map("delivery_proofs")
}

model RiderAvailability {
  riderId         String   @id @map("rider_id") @db.Uuid
  online          Boolean  @default(false)
  acceptingOrders Boolean  @default(false) @map("accepting_orders")
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)
  activeJobCount  Int      @default(0) @map("active_job_count")
  updatedAt       DateTime @updatedAt @map("updated_at")
  rider           User     @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([online, acceptingOrders])
  @@map("rider_availability")
}

// ── Ride domain — sibling to delivery, not an extension of it. ──────────────
// See docs/RIDE-001A-BACKEND-AUDIT.md and docs/RIDE-001B-ARCHITECTURE-SPEC.md.

enum RideType {
  ECONOMY
  COMFORT
  XL
  TRICYCLE
}

/// How a surcharge zone adds to a fare. FLAT adds a fixed amount in naira;
/// MULTIPLIER scales the metered fare (base + distance + time) by a factor, so
/// 1.25 charges a quarter more. Either way the ride records the resulting
/// naira amount, because that is what a receipt has to show.
enum RideSurchargeType {
  FLAT
  MULTIPLIER
}

/// Which end of the trip puts it inside a zone. An airport surcharge is
/// usually EITHER — the run out and the run back both carry the cost — but
/// PICKUP and DROPOFF exist because that is a commercial choice, not ours.
enum RideSurchargeTrigger {
  PICKUP
  DROPOFF
  EITHER
}

enum RideStatus {
  REQUESTED
  SEARCHING
  DRIVER_ASSIGNED
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_DRIVERS_FOUND
}

enum RideCancelledBy {
  CUSTOMER
  DRIVER
  SYSTEM
}

enum RidePaymentMethod {
  WALLET
  PAYSTACK
  FLUTTERWAVE
  OPAY
  CASH
}

enum RidePaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Ride {
  id                       String     @id @default(uuid()) @db.Uuid
  customerId               String     @map("customer_id") @db.Uuid
  driverId                 String?    @map("driver_id") @db.Uuid
  /// The passenger's 4-digit trip code, generated when a driver is assigned.
  /// Shown only to the passenger; the driver has to be told it out loud, which
  /// is the point — it proves the person getting in is the one who booked.
  /// Replaces a hardcoded "4729" that the driver app both checked against and
  /// printed on its own screen.
  verificationCode         String?    @map("verification_code") @db.VarChar(8)
  /// Unguessable token behind the passenger's "share my trip" link. Minted on
  /// demand, reused for the life of the ride, and readable without a login —
  /// the person following the trip is family, not a DrippleX account.
  shareToken               String?    @unique @map("share_token") @db.VarChar(64)
  rideType                 RideType   @map("ride_type")
  status                   RideStatus @default(REQUESTED)
  pickupLatitude           Decimal    @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude          Decimal    @map("pickup_longitude") @db.Decimal(10, 7)
  pickupAddress            String?    @map("pickup_address") @db.VarChar(500)
  dropoffLatitude          Decimal    @map("dropoff_latitude") @db.Decimal(10, 7)
  dropoffLongitude         Decimal    @map("dropoff_longitude") @db.Decimal(10, 7)
  dropoffAddress           String?    @map("dropoff_address") @db.VarChar(500)
  estimatedDistanceMeters  Int?       @map("estimated_distance_meters")
  estimatedDurationSeconds Int?       @map("estimated_duration_seconds")
  baseFare                 Decimal    @default(0) @map("base_fare") @db.Decimal(12, 2)
  distanceFare             Decimal    @default(0) @map("distance_fare") @db.Decimal(12, 2)
  timeFare                 Decimal    @default(0) @map("time_fare") @db.Decimal(12, 2)
  totalFare                Decimal    @default(0) @map("total_fare") @db.Decimal(12, 2)

  /// What a surcharge zone added, in naira, and which zone did it.
  ///
  /// The name is snapshotted alongside the id so a receipt still reads
  /// "Airport" after the zone has been renamed or deactivated — a settled trip
  /// must keep explaining itself even when the pricing behind it has moved on.
  /// Zero and null mean no zone applied, which is the normal case.
  surchargeAmount   Decimal @default(0) @map("surcharge_amount") @db.Decimal(12, 2)
  surchargeZoneId   String? @map("surcharge_zone_id") @db.Uuid
  surchargeZoneName String? @map("surcharge_zone_name") @db.VarChar(120)

  promotionId            String?                  @map("promotion_id") @db.Uuid
  promoDiscount          Decimal                  @default(0) @map("promo_discount") @db.Decimal(12, 2)
  paymentMethod          RidePaymentMethod?       @map("payment_method")
  paymentStatus          RidePaymentStatus        @default(PENDING) @map("payment_status")
  platformCommission     Decimal?                 @map("platform_commission") @db.Decimal(12, 2)
  platformCommissionRate Decimal?                 @map("platform_commission_rate") @db.Decimal(5, 4)
  driverEarning          Decimal?                 @map("driver_earning") @db.Decimal(12, 2)
  tipAmount              Decimal?                 @map("tip_amount") @db.Decimal(12, 2)
  requestedAt            DateTime                 @default(now()) @map("requested_at")
  assignedAt             DateTime?                @map("assigned_at")
  arrivedAt              DateTime?                @map("arrived_at")
  startedAt              DateTime?                @map("started_at")
  completedAt            DateTime?                @map("completed_at")
  cancelledAt            DateTime?                @map("cancelled_at")
  cancelledBy            RideCancelledBy?         @map("cancelled_by")
  cancellationReason     String?                  @map("cancellation_reason") @db.VarChar(500)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  customer               User                     @relation("RideCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  driver                 User?                    @relation("RideDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// SetNull, not Cascade: deleting a zone must never delete the rides it
  /// priced. surchargeZoneName carries the label on regardless.
  surchargeZone          RideSurchargeZone?       @relation(fields: [surchargeZoneId], references: [id], onDelete: SetNull)
  trackingPoints         RideTracking[]
  offers                 RideOffer[]
  paymentTransactions    RidePaymentTransaction[]
  ratings                RideRating[]
  problemReports         RideProblemReport[]

  @@index([customerId])
  @@index([driverId])
  @@index([status])
  @@index([requestedAt])
  // DPX-OPS-001 module-level audit (2026-08-05): the Live Activity Feed
  // (`OperationsDashboardService.getActivityFeed()`, polled every 15s) sorts
  // cancelled rides by cancelledAt, and OperationsAnalyticsService
  // .getDriverUtilization() range-filters completed rides by completedAt —
  // neither had a supporting index.
  @@index([cancelledAt])
  @@index([completedAt])
  @@map("rides")
}

model RidePaymentTransaction {
  id                    String            @id @default(uuid()) @db.Uuid
  rideId                String            @map("ride_id") @db.Uuid
  provider              PaymentProvider
  providerReference     String            @unique @map("provider_reference") @db.VarChar(100)
  providerTransactionId String?           @map("provider_transaction_id") @db.VarChar(100)
  status                TransactionStatus @default(PENDING)
  amount                Decimal           @db.Decimal(12, 2)
  currency              String            @default("NGN") @db.VarChar(3)
  authorizationUrl      String?           @map("authorization_url") @db.VarChar(2048)
  accessCode            String?           @map("access_code") @db.VarChar(100)
  gatewayResponse       Json?             @map("gateway_response")
  paidAt                DateTime?         @map("paid_at")
  verifiedAt            DateTime?         @map("verified_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  ride                  Ride              @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([providerReference])
  @@index([status])
  @@map("ride_payment_transactions")
}

enum RideRatingRole {
  CUSTOMER
  DRIVER
}

model RideRating {
  id              String         @id @default(uuid()) @db.Uuid
  rideId          String         @map("ride_id") @db.Uuid
  raterId         String         @map("rater_id") @db.Uuid
  rateeId         String         @map("ratee_id") @db.Uuid
  raterRole       RideRatingRole @map("rater_role")
  rating          Int
  comment         String?        @db.VarChar(1000)
  categoryRatings Json?          @map("category_ratings")
  /// DPX-REVIEWS-001 — preset tags chosen from the fixed driver-rating set.
  tags            String[]       @default([]) @map("tags")
  createdAt       DateTime       @default(now()) @map("created_at")
  ride            Ride           @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@unique([rideId, raterRole])
  @@index([rateeId])
  @@map("ride_ratings")
}

enum RideProblemCategory {
  WRONG_FARE
  DRIVER_BEHAVIOUR
  UNSAFE_DRIVING
  LOST_ITEM
  VEHICLE_ISSUE
  OTHER
}

enum RideProblemStatus {
  OPEN
  RESOLVED
}

model RideProblemReport {
  id          String              @id @default(uuid()) @db.Uuid
  rideId      String              @map("ride_id") @db.Uuid
  reporterId  String              @map("reporter_id") @db.Uuid
  category    RideProblemCategory
  description String?             @db.VarChar(2000)
  status      RideProblemStatus   @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at")
  resolvedAt  DateTime?           @map("resolved_at")
  ride        Ride                @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([status])
  @@map("ride_problem_reports")
}

enum RideOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model RideOffer {
  id          String          @id @default(uuid()) @db.Uuid
  rideId      String          @map("ride_id") @db.Uuid
  driverId    String          @map("driver_id") @db.Uuid
  status      RideOfferStatus @default(PENDING)
  offeredAt   DateTime        @default(now()) @map("offered_at")
  expiresAt   DateTime        @map("expires_at")
  respondedAt DateTime?       @map("responded_at")
  ride        Ride            @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driver      User            @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([rideId])
  @@index([driverId, status])
  @@index([status, expiresAt])
  // DPX-OPS-001 module-level audit (2026-08-05): OperationsAnalyticsService
  // .getDispatchPerformance() range-filters on offeredAt with no driverId in
  // the predicate — none of the existing indexes cover that scan.
  @@index([offeredAt])
  @@map("ride_offers")
}

model RideTracking {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  latitude  Decimal  @db.Decimal(10, 7)
  longitude Decimal  @db.Decimal(10, 7)
  heading   Float?
  speed     Float?
  createdAt DateTime @default(now()) @map("created_at")
  ride      Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)

  @@index([rideId, createdAt])
  @@map("ride_tracking")
}

model DriverAvailability {
  driverId       String   @id @map("driver_id") @db.Uuid
  online         Boolean  @default(false)
  acceptingRides Boolean  @default(false) @map("accepting_rides")
  vehicleType    RideType @map("vehicle_type")
  latitude       Decimal? @db.Decimal(10, 7)
  longitude      Decimal? @db.Decimal(10, 7)

  /// When latitude/longitude were last written. Distinct from `updatedAt`,
  /// which Prisma bumps on ANY write to this row — including activeRideCount
  /// changes at accept and completion — and so reports a location as fresh
  /// when only the ride counter moved. Dispatch needs to know how old the
  /// *position* is, so it reads this and nothing else.
  locationUpdatedAt DateTime? @map("location_updated_at")

  activeRideCount Int      @default(0) @map("active_ride_count")
  updatedAt       DateTime @updatedAt @map("updated_at")
  driver          User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([online, acceptingRides, vehicleType])
  /// Dispatch filters on these four together before ranking by distance.
  /// Named explicitly: Prisma's generated name for four columns this long
  /// exceeds Postgres's 63-character identifier limit and gets truncated,
  /// which would drift from the name the migration creates.
  @@index([online, acceptingRides, vehicleType, locationUpdatedAt], map: "driver_availability_online_accepting_vehicle_location_idx")
  @@map("driver_availability")
}

model DriverKyc {
  id                 String                @id @default(uuid()) @db.Uuid
  driverId           String                @map("driver_id") @db.Uuid
  documentType       KycDocumentType       @map("document_type")
  documentNumber     String                @map("document_number") @db.VarChar(100)
  frontImage         String                @map("front_image") @db.VarChar(2048)
  backImage          String?               @map("back_image") @db.VarChar(2048)
  /// DPX-DRIVER-002 — insurance/licence expiry tracking. Null for document
  /// types with no meaningful expiry (e.g. GUARANTOR_ID).
  expiresAt          DateTime?             @map("expires_at")
  verificationStatus KycVerificationStatus @default(PENDING) @map("verification_status")
  reviewedBy         String?               @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at")
  remarks            String?               @db.VarChar(1000)
  createdAt          DateTime              @default(now()) @map("created_at")
  driver             User                  @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([verificationStatus])
  @@map("driver_kyc")
}

/// DPX-RIDER-002 — delivery-rider document KYC. Separate model from DriverKyc
/// (ride-hailing drivers) and CustomerKyc; riders submit an ID + a guarantor
/// ID. Same hosted-URL-string convention for images as DriverKyc.
model RiderKyc {
  id                 String                @id @default(uuid()) @db.Uuid
  riderId            String                @map("rider_id") @db.Uuid
  documentType       KycDocumentType       @map("document_type")
  documentNumber     String                @map("document_number") @db.VarChar(100)
  frontImage         String                @map("front_image") @db.VarChar(2048)
  backImage          String?               @map("back_image") @db.VarChar(2048)
  verificationStatus KycVerificationStatus @default(PENDING) @map("verification_status")
  reviewedBy         String?               @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at")
  remarks            String?               @db.VarChar(1000)
  createdAt          DateTime              @default(now()) @map("created_at")
  rider              User                  @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([verificationStatus])
  @@map("rider_kyc")
}

/// DPX-PROFILE-KYC-001 — Customer-persona document KYC. Deliberately not
/// shared with DriverKyc: different persona, different (richer) lifecycle,
/// and DriverKyc is already frozen/shipped — extending it risks regressing
/// a frozen module. documentType reuses KycDocumentType (NATIONAL_ID/
/// PASSPORT/DRIVER_LICENSE all apply to a person's ID); frontImageUrl/
/// backImageUrl/selfieUrl are URL strings, same contract as DriverKyc's
/// frontImage/backImage — no file-upload/storage service exists yet, this
/// is not a new limitation.
/// DPX-PROFILE-KYC-002 (founder decision 2026-08-07): lifecycle timestamps
/// beyond the current-state fields, kept distinct so each records exactly
/// one transition instead of overloading `updatedAt`:
///   startedAt        -- first entered IN_PROGRESS (KYC actually begun)
///   submittedAt       -- user completed submission, entered PENDING_REVIEW
///   reviewStartedAt   -- a reviewer picked it up (may lag submittedAt by a
///                        real queue delay; distinct from submission itself)
///   reviewedAt        -- the review decision was made (approve or reject)
///   verifiedAt        -- entered VERIFIED
///   rejectedAt        -- entered REJECTED
///   expiresAt          -- when a VERIFIED record lapses (drives a future
///                        expiry job -- no such job exists yet, see design
///                        doc's "explicitly not built this round")
model CustomerKyc {
  id              String            @id @default(uuid()) @db.Uuid
  userId          String            @map("user_id") @db.Uuid
  level           CustomerKycLevel  @default(LEVEL_0)
  status          CustomerKycStatus @default(NOT_STARTED)
  documentType    KycDocumentType?  @map("document_type")
  documentNumber  String?           @map("document_number") @db.VarChar(100)
  frontImageUrl   String?           @map("front_image_url") @db.VarChar(2048)
  backImageUrl    String?           @map("back_image_url") @db.VarChar(2048)
  selfieUrl       String?           @map("selfie_url") @db.VarChar(2048)
  reviewedBy      String?           @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?         @map("reviewed_at")
  remarks         String?           @db.VarChar(1000)
  startedAt       DateTime?         @map("started_at")
  submittedAt     DateTime?         @map("submitted_at")
  reviewStartedAt DateTime?         @map("review_started_at")
  verifiedAt      DateTime?         @map("verified_at")
  rejectedAt      DateTime?         @map("rejected_at")
  expiresAt       DateTime?         @map("expires_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("customer_kyc")
}

/// DPX-DRIVER-002 — structured vehicle record. Replaces the pre-existing
/// pattern of a vehicle being nothing but an uploaded `VEHICLE_REGISTRATION`
/// document (`DriverKyc`) and `DriverAvailability.vehicleType`'s single
/// ride-category enum. A driver's registered `Vehicle.rideCategory`
/// determines which ride categories they're eligible to serve.
enum VehicleApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Vehicle {
  id             String                @id @default(uuid()) @db.Uuid
  driverId       String                @map("driver_id") @db.Uuid
  plateNumber    String                @map("plate_number") @db.VarChar(20)
  make           String                @db.VarChar(50)
  model          String                @db.VarChar(50)
  color          String                @db.VarChar(30)
  year           Int
  rideCategory   RideType              @map("ride_category")
  // DPX-DRIVER-017 — passenger capacity is operational data in its own right and
  // must not be inferred from rideCategory (founder decision). Nullable so the
  // additive migration leaves existing rows untouched (unknown, not fabricated);
  // new vehicle submissions require it via CreateVehicleDto.
  seats          Int?
  isActive       Boolean               @default(true) @map("is_active")
  approvalStatus VehicleApprovalStatus @default(PENDING) @map("approval_status")
  approvedAt     DateTime?             @map("approved_at")
  approvedBy     String?               @map("approved_by") @db.Uuid
  rejectedReason String?               @map("rejected_reason") @db.VarChar(1000)
  photos         String[]              @default([])
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  driver         User                  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  inspections    Inspection[]
  sosAlerts      SosAlert[]

  @@unique([plateNumber])
  @@index([driverId])
  @@index([approvalStatus])
  @@map("vehicles")
}

/// DPX-DRIVER-002 Phase 3 — a physical location a driver books a mandatory
/// inspection appointment at.
model InspectionCentre {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(150)
  /// Optional (founder decision, 2026-08-17: "no address needed for now").
  /// DrippleX's own centres are identified by name and city; drivers who need
  /// directions are pointed at the support WhatsApp line on the booking screen.
  /// A centre with no address must never render as a blank or "null" line.
  address     String?      @db.VarChar(500)
  city        String       @db.VarChar(100)
  latitude    Decimal?     @db.Decimal(10, 7)
  longitude   Decimal?     @db.Decimal(10, 7)
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  inspections Inspection[]

  @@index([isActive])
  @@index([city])
  @@map("inspection_centres")
}

enum InspectionStatus {
  SCHEDULED
  PASSED
  FAILED
  CANCELLED
}

/// DPX-DRIVER-002 Phase 3 — one mandatory physical inspection appointment
/// (driver + vehicle + centre), its structured checklist result, and any
/// periodic re-inspection this record triggers. `checklist` is a JSON array
/// of `{ item: string, category: 'DRIVER' | 'VEHICLE', passed: boolean,
/// note?: string }` — structured, not free-text-only, so "which check fails
/// most often" stays reportable. See
/// docs/DPX-DRIVER-002-INSPECTION-STANDARD.md Phase 3.
model Inspection {
  id               String           @id @default(uuid()) @db.Uuid
  driverId         String           @map("driver_id") @db.Uuid
  vehicleId        String           @map("vehicle_id") @db.Uuid
  centreId         String           @map("centre_id") @db.Uuid
  /// The officer who conducted the walkthrough and recorded the checklist.
  inspectorId      String?          @map("inspector_id") @db.Uuid
  /// The supervisor who made the final pass/fail call. Distinct from
  /// `inspectorId` — officers record, supervisors decide (per
  /// docs/DPX-DRIVER-002-INSPECTION-STANDARD.md's role split).
  decidedBy        String?          @map("decided_by") @db.Uuid
  status           InspectionStatus @default(SCHEDULED)
  scheduledAt      DateTime         @map("scheduled_at")
  completedAt      DateTime?        @map("completed_at")
  checklist        Json?
  notes            String?          @db.VarChar(2000)
  photos           String[]         @default([])
  /// Non-null = this inspection was scheduled as a re-inspection of an
  /// earlier one (accident/complaint/vehicle-change/admin-requested/
  /// periodic-renewal). Self-referencing, not an enum reason code — the
  /// reason lives in `notes` at scheduling time.
  reinspectionOfId String?          @map("reinspection_of_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  driver           User             @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicle          Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  centre           InspectionCentre @relation(fields: [centreId], references: [id], onDelete: Restrict)
  reinspectionOf   Inspection?      @relation("Reinspection", fields: [reinspectionOfId], references: [id], onDelete: SetNull)
  reinspections    Inspection[]     @relation("Reinspection")

  @@index([driverId])
  @@index([vehicleId])
  @@index([centreId])
  @@index([status])
  @@index([scheduledAt])
  // DPX-OPS-001 module-level audit (2026-08-05): the Live Activity Feed
  // sorts decided inspections by completedAt (polled every 15s) — no
  // existing index covers that.
  @@index([completedAt])
  @@map("inspections")
}

/// Driver Slice 2 item 3 (founder-approved 2026-08-04): "a basic 'submit an
/// issue, admin sees a queue' loop" — deliberately not ride-scoped (that's
/// `RideProblemReport`) and deliberately not the safety-relevant Incident
/// Reporting item (item 4) — this is general account/payout/app/KYC
/// support, the same class of thing a driver would otherwise email support
/// about.
enum DriverSupportCategory {
  PAYOUT
  ACCOUNT
  APP_BUG
  KYC
  OTHER
}

enum DriverSupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model DriverSupportTicket {
  id            String                    @id @default(uuid()) @db.Uuid
  driverId      String                    @map("driver_id") @db.Uuid
  category      DriverSupportCategory
  subject       String                    @db.VarChar(200)
  description   String                    @db.VarChar(2000)
  status        DriverSupportTicketStatus @default(OPEN)
  adminResponse String?                   @map("admin_response") @db.VarChar(2000)
  resolvedBy    String?                   @map("resolved_by") @db.Uuid
  resolvedAt    DateTime?                 @map("resolved_at")
  createdAt     DateTime                  @default(now()) @map("created_at")
  updatedAt     DateTime                  @updatedAt @map("updated_at")
  driver        User                      @relation("DriverSupportTicketDriver", fields: [driverId], references: [id], onDelete: Cascade)
  resolver      User?                     @relation("DriverSupportTicketResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([status])
  @@map("driver_support_tickets")
}

/// Driver Slice 2 item 4 — Incident Reporting (founder-approved 2026-08-04):
/// safety-relevant (accident, passenger altercation, vehicle breakdown),
/// distinct from the general-purpose Driver Support ticket above and from
/// the ride-scoped `RideProblemReport`. Also the capability
/// `docs/DPX-DRIVER-004-VEHICLE-APPROVAL-LIFECYCLE-POLICY.md` already
/// flagged as needed for its own "vehicle-changed"/"safety complaint"
/// re-inspection triggers — this is that capability existing now.
enum IncidentCategory {
  ACCIDENT
  PASSENGER_ALTERCATION
  VEHICLE_BREAKDOWN
  SAFETY_CONCERN
  OTHER
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model IncidentReport {
  id             String               @id @default(uuid()) @db.Uuid
  driverId       String               @map("driver_id") @db.Uuid
  /// Optional — an incident can happen mid-trip (accident, passenger
  /// altercation) or while simply online/off-trip (vehicle breakdown).
  /// Deliberately a plain id, not a Prisma relation to `Ride` — the Ride
  /// module is frozen and a declared relation would require a matching
  /// back-relation array field on the `Ride` model itself. Any lookup
  /// against the ride reads `Ride` directly via Prisma by this id, the
  /// same cross-module read pattern as `DriverRideContactService`.
  rideId         String?              @map("ride_id") @db.Uuid
  category       IncidentCategory
  severity       IncidentSeverity
  description    String               @db.VarChar(2000)
  latitude       Decimal?             @db.Decimal(10, 7)
  longitude      Decimal?             @db.Decimal(10, 7)
  status         IncidentReportStatus @default(OPEN)
  adminNotes     String?              @map("admin_notes") @db.VarChar(2000)
  acknowledgedBy String?              @map("acknowledged_by") @db.Uuid
  acknowledgedAt DateTime?            @map("acknowledged_at")
  resolvedAt     DateTime?            @map("resolved_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  driver         User                 @relation("IncidentReportDriver", fields: [driverId], references: [id], onDelete: Cascade)
  acknowledger   User?                @relation("IncidentReportAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([rideId])
  @@index([status])
  @@index([severity])
  // DPX-OPS-001 module-level audit (2026-08-05): Live Activity Feed sort.
  @@index([createdAt])
  @@map("incident_reports")
}

/// Driver Slice 2 item 5 — SOS/Emergency (founder-approved 2026-08-04):
/// DrippleX Operations first — immediate alert to ops with driver id,
/// GPS, active trip, timestamp, vehicle, battery level (if available);
/// the customer (if on an active ride) is notified assistance was
/// requested. Explicitly NOT auto-contacting emergency services or the
/// driver's emergency contact in v1 — that needs country-specific legal/
/// operational policy the founder deferred. `rideId` mirrors
/// `IncidentReport.rideId` — a plain id, no Prisma relation to the frozen
/// `Ride` model.
enum SosAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model SosAlert {
  id                 String         @id @default(uuid()) @db.Uuid
  driverId           String         @map("driver_id") @db.Uuid
  rideId             String?        @map("ride_id") @db.Uuid
  vehicleId          String?        @map("vehicle_id") @db.Uuid
  latitude           Decimal?       @db.Decimal(10, 7)
  longitude          Decimal?       @db.Decimal(10, 7)
  /// 0-100, only when the browser's Battery Status API is available —
  /// deprecated/unsupported in most browsers today, honestly nullable.
  batteryLevel       Int?           @map("battery_level")
  status             SosAlertStatus @default(OPEN)
  adminNotes         String?        @map("admin_notes") @db.VarChar(2000)
  acknowledgedBy     String?        @map("acknowledged_by") @db.Uuid
  acknowledgedAt     DateTime?      @map("acknowledged_at")
  resolvedAt         DateTime?      @map("resolved_at")
  /// Set once the ride's customer (if any) has been sent the "assistance
  /// requested" notice.
  customerNotifiedAt DateTime?      @map("customer_notified_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  driver             User           @relation("SosAlertDriver", fields: [driverId], references: [id], onDelete: Cascade)
  acknowledger       User?          @relation("SosAlertAcknowledger", fields: [acknowledgedBy], references: [id], onDelete: SetNull)
  vehicle            Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([driverId])
  @@index([rideId])
  @@index([status])
  // DPX-OPS-001 module-level audit (2026-08-05): Live Activity Feed sort.
  @@index([createdAt])
  @@map("sos_alerts")
}

enum DriverShiftStatus {
  ACTIVE
  ON_BREAK
  ENDED
}

/// Driver Slice 2 item 6 — Shift Management (founder-approved 2026-08-04):
/// a driver-initiated work session, distinct from `DriverAvailability.online`
/// (the real-time ride-dispatch flag, owned by the frozen Ride module — a
/// shift does not toggle it; the two are independent by design for v1).
/// `continuousSince` resets every time a break ends (or the shift starts),
/// so `now - continuousSince` while ACTIVE is the driver's current
/// continuous-driving duration — the basis for the advisory break-reminder/
/// fatigue-warning computation in `DriverShiftService`. At most one
/// ACTIVE/ON_BREAK shift per driver is enforced at the service layer (no DB
/// constraint — same level of enforcement as other single-active-record
/// patterns in this codebase).
model DriverShift {
  id                   String            @id @default(uuid()) @db.Uuid
  driverId             String            @map("driver_id") @db.Uuid
  status               DriverShiftStatus @default(ACTIVE)
  startedAt            DateTime          @default(now()) @map("started_at")
  endedAt              DateTime?         @map("ended_at")
  breakStartedAt       DateTime?         @map("break_started_at")
  continuousSince      DateTime          @default(now()) @map("continuous_since")
  totalBreakSeconds    Int               @default(0) @map("total_break_seconds")
  /// Set when Operations force-ends an abandoned/stuck shift instead of the
  /// driver ending it themselves.
  forceEndedBy         String?           @map("force_ended_by") @db.Uuid
  adminNotes           String?           @map("admin_notes") @db.VarChar(1000)
  /// Driver Slice 2 item 8 — set once a push notification has fired for
  /// this threshold, so DriverShiftReminderSweepService doesn't re-notify
  /// every sweep. The two "continuous" ones are cleared whenever
  /// `continuousSince` resets (a break ends) — a fresh continuous stretch
  /// can trigger its own reminder/warning again.
  breakReminderSentAt  DateTime?         @map("break_reminder_sent_at")
  fatigueWarningSentAt DateTime?         @map("fatigue_warning_sent_at")
  dailyLimitNotifiedAt DateTime?         @map("daily_limit_notified_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  driver               User              @relation("DriverShiftDriver", fields: [driverId], references: [id], onDelete: Cascade)
  forceEnder           User?             @relation("DriverShiftForceEnder", fields: [forceEndedBy], references: [id], onDelete: SetNull)

  @@index([driverId, status])
  @@index([driverId, startedAt])
  @@index([status])
  // DPX-OPS-001 module-level audit (2026-08-05): the Live Activity Feed
  // (polled every 15s) and OperationsAnalyticsService both query across all
  // drivers' shifts ordered/filtered by startedAt or endedAt with no
  // driverId predicate — the existing composite indexes above lead with
  // driverId and can't serve those scans.
  @@index([startedAt])
  @@index([endedAt])
  @@map("driver_shifts")
}

/// A driver's recurring weekly intent to be online — informational for
/// Operations staffing visibility only; it does NOT automatically toggle
/// `DriverAvailability.online` (that would mean writing into the frozen
/// Ride module's dispatch flag from a sweep job — a real automation
/// decision deliberately not made here; see DRIVER-SLICE-2-AUDIT.md).
/// `startMinute`/`endMinute` are minutes-since-midnight (0-1439) in the
/// driver's local day, timezone-naive by design (matches how the rest of
/// this module treats driver-local times — no per-driver timezone field
/// exists yet).
model DriverPlannedAvailability {
  id          String   @id @default(uuid()) @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  /// 0 = Sunday .. 6 = Saturday.
  dayOfWeek   Int      @map("day_of_week")
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  driver      User     @relation("DriverPlannedAvailabilityDriver", fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@map("driver_planned_availability")
}

