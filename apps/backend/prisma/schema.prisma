/// DPX-CORE-002 — the universal Promotion Platform engine. Originally
/// built order/marketplace-only (RIDE-004.2 era); generalized in place
/// rather than duplicated per "extend, don't build a second promo
/// system." `domains: []` (default) means "applies everywhere," matching
/// the existing `merchantId: null` = "every merchant" convention — no
/// PLATFORM/ALL enum value needed. `rules` carries the long-tail
/// eligibility filters (geo, vehicle/ride type, payment method,
/// whitelist/blacklist, new-vs-returning, weekday/time-of-day) as a
/// validated JSON shape (see PromotionRules in promotion-rules.ts) rather
/// than one column per filter — the handful of filters actually queried
/// at scale (domains, status, merchant, priority, date range) stay real
/// indexed columns exactly as they already were.
model Promotion {
  id             String                @id @default(uuid()) @db.Uuid
  code           String?               @unique @db.VarChar(50)
  name           String                @db.VarChar(150)
  type           PromotionType
  status         PromotionStatus       @default(DRAFT)
  domains        PromotionDomain[]     @default([])
  percentOff     Decimal?              @map("percent_off") @db.Decimal(5, 2)
  amountOff      Decimal?              @map("amount_off") @db.Decimal(12, 2)
  creditAmount   Decimal?              @map("credit_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?              @map("max_discount") @db.Decimal(12, 2)
  buyQty         Int?                  @map("buy_qty")
  getQty         Int?                  @map("get_qty")
  priority       Int                   @default(0)
  stackable      Boolean               @default(false)
  usageLimit     Int?                  @map("usage_limit")
  usageCount     Int                   @default(0) @map("usage_count")
  perUserLimit   Int?                  @map("per_user_limit")
  perDeviceLimit Int?                  @map("per_device_limit")
  minOrderAmount Decimal?              @map("min_order_amount") @db.Decimal(12, 2)
  rules          Json?
  startsAt       DateTime?             @map("starts_at")
  endsAt         DateTime?             @map("ends_at")
  pausedAt       DateTime?             @map("paused_at")
  archivedAt     DateTime?             @map("archived_at")
  merchantId     String?               @map("merchant_id") @db.Uuid
  clonedFromId   String?               @map("cloned_from_id") @db.Uuid
  createdBy      String?               @map("created_by") @db.Uuid
  metadata       Json?
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")
  deletedAt      DateTime?             @map("deleted_at")
  redemptions    PromotionRedemption[]
  clonedFrom     Promotion?            @relation("PromotionClone", fields: [clonedFromId], references: [id], onDelete: SetNull)
  clones         Promotion[]           @relation("PromotionClone")

  @@index([status])
  @@index([type])
  /// GIN, not the default btree. `domains` is an array and every query against
  /// it is a containment test (`has`/`hasSome`), which btree cannot serve. The
  /// migration that created this built it as GIN; declaring the type here is
  /// what stops `prisma migrate diff` proposing to replace it with a btree
  /// index that would quietly stop being used.
  @@index([domains], type: Gin)
  @@index([merchantId])
  @@index([startsAt, endsAt])
  @@index([priority])
  @@index([deletedAt])
  @@map("promotions")
}

model PromotionRedemption {
  id                  String    @id @default(uuid()) @db.Uuid
  promotionId         String    @map("promotion_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
