generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum RegistrationChannel {
  CUSTOMER_WEB
  CUSTOMER_WEB_GOOGLE
  MERCHANT_PORTAL
  RIDER_PORTAL
  DRIVER_PORTAL
  OPS_INVITE
  ADMIN_INVITE
  SEED
  // DPX-DRIVER-015 — dedicated portal channels for the admin portal and
  // operations console login endpoints, so their sessions/tokens carry an
  // accurate portal claim (the JWT strategy round-trips the channel).
  ADMIN_PORTAL
  OPERATIONS_CONSOLE
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum IdentityVerificationType {
  EMAIL
  PHONE
}

enum MerchantStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// DPX-RIDER-001 — delivery-rider approval lifecycle, mirrors DriverStatus.
/// PENDING → (UNDER_REVIEW) → APPROVED | REJECTED; APPROVED → SUSPENDED →
/// (reactivate) APPROVED. Ops/Admin drive the transitions.
enum RiderStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessStatus {
  DRAFT
  SUBMITTED
  ACTIVE
  /// Merchant-initiated temporary closure (self-service) — distinct from
  /// admin-initiated `SUSPENDED`. See `Business.pausedAt`/`pauseReason`.
  PAUSED
  SUSPENDED
}

enum BusinessVerificationStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

/// What a merchant SELLS, as opposed to how it is legally constituted.
///
/// BusinessType is a legal structure — SOLE_PROPRIETORSHIP, PARTNERSHIP — and
/// was the only thing resembling a category, so the marketplace had nothing to
/// filter on. Its category chips fell back to a free-text search of merchant
/// NAMES, which meant a hotel called "Tahir Guest Palace" never appeared under
/// Hotels, and the storefront-icon lookup never matched, so every merchant card
/// drew the same default glyph.
///
/// The values are exactly the chips the marketplace and home screens already
/// offer, so the existing UI becomes real rather than a new taxonomy being
/// invented alongside it. OTHER exists so a merchant is never forced into a
/// wrong one; UNCATEGORISED is absent by design — that state is `null`.
enum MerchantCategory {
  SUPERMARKET
  RESTAURANT
  PHARMACY
  ELECTRONICS
  FASHION
  BEAUTY
  HARDWARE
  HOTEL
  FURNITURE
  SERVICES
  WHOLESALE
  OTHER
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LIMITED_LIABILITY
  CORPORATION
  OTHER
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  CAC_CERTIFICATE
  BUSINESS_REGISTRATION
  VEHICLE_REGISTRATION
  GUARANTOR_ID
  /// DPX-DRIVER-002
  INSURANCE
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// DPX-PROFILE-KYC-001 — Customer-persona document KYC lifecycle. Richer
/// than KycVerificationStatus (driver/merchant) per founder decision
/// 2026-08-07: the UI needs to distinguish "never started" from "in review"
/// from "needs new documents," not just pending/verified/rejected.
enum CustomerKycStatus {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
  REQUIRES_RESUBMISSION
}

/// DPX-PROFILE-KYC-001
enum CustomerKycLevel {
  LEVEL_0
  LEVEL_1
  LEVEL_2
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  LOCKED
}

/// DPX-CORE-003 — the universal order lifecycle shared by every commerce
/// vertical (marketplace today; food/grocery/pharmacy/logistics reuse this
/// same enum, never a per-vertical copy). `FAILED` is kept for backward
/// compatibility with the physical Postgres enum (Postgres can't drop an
/// enum value without a full type rebuild) but is no longer produced by
/// any code path — "payment failed before confirmation" is now expressed
/// as `CANCELLED` + `PaymentStatus.FAILED`, matching how `Ride` already
/// keeps ride-level and payment-level status orthogonal.
enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  DRIVER_ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
  /// @deprecated no longer produced; see the model doc comment.
  FAILED
}

enum OrderCancelledBy {
  CUSTOMER
  MERCHANT
  ADMIN
  SYSTEM
}

enum OrderDisputeStatus {
  OPEN
  RESOLVED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL_REFUND
}

enum FulfillmentType {
  DELIVERY
  PICKUP
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MONIEPOINT
  OPAY
}

/// How a customer chose to pay for a marketplace order — distinct from
/// PaymentProvider (external gateways only). WALLET and CASH never create
/// a PaymentTransaction row; mirrors RidePaymentMethod's separation.
enum OrderPaymentMethod {
  PAYSTACK
  FLUTTERWAVE
  OPAY
  WALLET
  CASH
  /// DPX-COMMERCIAL-001 Slice 2 — Marketplace mode B ("Pay to Merchant").
  /// The customer pays the merchant directly (bank transfer/POS); DrippleX
  /// never handles or verifies the payment, so paymentStatus stays PENDING
  /// for the order's entire lifecycle — settlement accrues the commission
  /// owed to the merchant's CommissionAccount instead of crediting Wallet.
  /// See docs/DPX-COMMERCIAL-001-REVENUE-SETTLEMENT-CREDIT-POLICY.md §3.3.
  MERCHANT_DIRECT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  ABANDONED
  CANCELLED
  REFUNDED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ACCEPTED
  PICKED_UP
  ON_THE_WAY
  ARRIVED
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum AssignmentMethod {
  AUTO
  MANUAL
}

enum ProofType {
  PHOTO
  OTP
  SIGNATURE
  PHOTO_AND_OTP
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id                          String                       @id @default(uuid()) @db.Uuid
  email                       String                       @unique @db.Citext
  phone                       String?                      @unique @db.VarChar(32)
  passwordHash                String                       @map("password_hash")
  /// Google's stable account subject ID (profile.id from the OAuth2 userinfo
  /// response). Set when a user signs in with Google, either at account
  /// creation or when linking Google to an existing email/phone account.
  googleId                    String?                      @unique @map("google_id")
  firstName                   String                       @map("first_name") @db.VarChar(100)
  lastName                    String                       @map("last_name") @db.VarChar(100)
  /// DPX-PROFILE-KYC-001 — URL only, no upload endpoint exists yet (same
  /// contract as DriverKyc.frontImage/backImage).
  profilePhotoUrl             String?                      @map("profile_photo_url") @db.VarChar(2048)
  /// DPX-PROFILE-KYC-001
  dateOfBirth                 DateTime?                    @map("date_of_birth") @db.Date
  /// DPX-PROFILE-KYC-001 — deliberately free-text, not a closed enum.
  gender                      String?                      @db.VarChar(50)
  status                      UserStatus                   @default(PENDING_VERIFICATION)
  registrationChannel         RegistrationChannel?         @map("registration_channel")
  emailVerifiedAt             DateTime?                    @map("email_verified_at")
  phoneVerifiedAt             DateTime?                    @map("phone_verified_at")
  lastLoginAt                 DateTime?                    @map("last_login_at")
  lastActiveAt                DateTime?                    @map("last_active_at")
  passwordChangedAt           DateTime?                    @map("password_changed_at")
  blockedAt                   DateTime?                    @map("blocked_at")
  blockedReason               String?                      @map("blocked_reason") @db.VarChar(500)
  roles                       UserRole[]
  authSessions                AuthSession[]
  passwordResetTokens         PasswordResetToken[]
  identityVerifications       IdentityVerification[]
  /// DPX-PROFILE-KYC-001 — Customer-persona document KYC, separate from
  /// driver/merchant KYC (DriverKyc/MerchantKyc) and from IdentityVerification
  /// (OTP/magic-link, not document verification).
  customerKycs                CustomerKyc[]
  customerProfile             CustomerProfile?
  merchantProfile             MerchantProfile?
  riderProfile                RiderProfile?
  driverProfile               DriverProfile?
  businesses                  Business[]
  merchantKycs                MerchantKyc[]
  bankAccounts                BankAccount[]
  customerBankAccounts        CustomerBankAccount[]
  walletPin                   WalletPin?
  withdrawalRequests          WithdrawalRequest[]          @relation("WithdrawalRequestUser")
  withdrawalsProcessed        WithdrawalRequest[]          @relation("WithdrawalRequestProcessedBy")
  customerAddresses           CustomerAddress[]
  carts                       Cart[]
  orders                      Order[]
  paymentTransactions         PaymentTransaction[]
  deliveryJobsAsCustomer      DeliveryJob[]                @relation("DeliveryCustomer")
  deliveryJobsAsMerchant      DeliveryJob[]                @relation("DeliveryMerchant")
  deliveryJobsAsRider         DeliveryJob[]                @relation("DeliveryRider")
  riderAvailability           RiderAvailability?
  ridesAsCustomer             Ride[]                       @relation("RideCustomer")
  ridesAsDriver               Ride[]                       @relation("RideDriver")
  driverAvailability          DriverAvailability?
  driverKycDocuments          DriverKyc[]
  riderKycDocuments           RiderKyc[]
  driverIdentityVerifications DriverIdentityVerification[]
  driverVerifiedDevices       DriverVerifiedDevice[]
  /// DPX-DRIVER-002
  driverVehicles              Vehicle[]
  driverInspections           Inspection[]
  driverSupportTickets        DriverSupportTicket[]        @relation("DriverSupportTicketDriver")
  driverSupportTicketsHandled DriverSupportTicket[]        @relation("DriverSupportTicketResolver")
  incidentReports             IncidentReport[]             @relation("IncidentReportDriver")
  incidentReportsAcknowledged IncidentReport[]             @relation("IncidentReportAcknowledger")
  sosAlerts                   SosAlert[]                   @relation("SosAlertDriver")
  sosAlertsAcknowledged       SosAlert[]                   @relation("SosAlertAcknowledger")
  driverShifts                DriverShift[]                @relation("DriverShiftDriver")
  driverShiftsForceEnded      DriverShift[]                @relation("DriverShiftForceEnder")
  driverPlannedAvailability   DriverPlannedAvailability[]  @relation("DriverPlannedAvailabilityDriver")
  /// DPX-OPS-001 Slice 2
  operationsCasesAssigned     OperationsCase[]             @relation("OperationsCaseAssignedTo")
  operationsCasesAssignedByMe OperationsCase[]             @relation("OperationsCaseAssignedBy")
  operationsCaseEvents        OperationsCaseEvent[]        @relation("OperationsCaseEventActor")
  sentMessages                Message[]                    @relation("MessageSender")
  receivedMessages            Message[]                    @relation("MessageRecipient")
  /// DPX-UTILITIES-001
  utilityPurchases            UtilityPurchase[]            @relation("UtilityPurchaseCustomer")
  rideOffers                  RideOffer[]
  notifications               Notification[]
  notificationPreferences     NotificationPreference[]
  deviceTokens                DeviceToken[]
  referral                    Referral?
  referralRedemption          ReferralRedemption?
  driverReferrals             DriverReferral[]
  passengerReferral           PassengerReferral?
  referralRewards             ReferralReward[]
  searchQueryLogs             SearchQueryLog[]
  recentSearches              RecentSearch[]
  reviews                     Review[]                     @relation("ReviewAuthor")
  reviewVotes                 ReviewVote[]
  reviewReports               ReviewReport[]               @relation("ReviewReporter")
  wishlists                   Wishlist[]                   @relation("WishlistCustomer")
  promotionRedemptions        PromotionRedemption[]
  loyaltyAccount              LoyaltyAccount?
  userAchievements            UserAchievement[]
  cmsContentVersions          CmsContentVersion[]          @relation("CmsContentVersionCreator")
  fraudSignals                FraudSignal[]                @relation("FraudSignalUser")
  fraudReviews                FraudSignal[]                @relation("FraudSignalReviewer")
  auditLogs                   AuditLog[]
  createdAt                   DateTime                     @default(now()) @map("created_at")
  updatedAt                   DateTime                     @updatedAt @map("updated_at")
  deletedAt                   DateTime?                    @map("deleted_at")

  @@index([status])
  @@index([deletedAt])
  @@index([registrationChannel])
  @@index([emailVerifiedAt])
  @@index([phoneVerifiedAt])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(100)
  description String?          @db.VarChar(500)
  isSystem    Boolean          @default(false) @map("is_system")
  users       UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@index([deletedAt])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  description String?          @db.VarChar(500)
  roles       RolePermission[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deletedAt   DateTime?        @map("deleted_at")

  @@index([deletedAt])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([userId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  grantedAt    DateTime   @default(now()) @map("granted_at")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@index([roleId])
  @@map("role_permissions")
}

model AuthSession {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  refreshTokenHash String?             @map("refresh_token_hash") @db.VarChar(64)
  portal           RegistrationChannel @map("portal")
  deviceId         String?             @map("device_id") @db.VarChar(128)
  deviceName       String?             @map("device_name") @db.VarChar(255)
  ipAddress        String?             @map("ip_address") @db.VarChar(45)
  userAgent        String?             @map("user_agent") @db.VarChar(512)
  rememberMe       Boolean             @default(false) @map("remember_me")
  expiresAt        DateTime            @map("expires_at")
  revokedAt        DateTime?           @map("revoked_at")
  lastSeenAt       DateTime            @default(now()) @map("last_seen_at")
  lastActiveAt     DateTime            @default(now()) @map("last_active_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([userId])
  @@index([userId, revokedAt])
  @@index([portal])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, consumedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model IdentityVerification {
  id           String                   @id @default(uuid()) @db.Uuid
  userId       String                   @map("user_id") @db.Uuid
  type         IdentityVerificationType
  tokenHash    String?                  @unique @map("token_hash") @db.VarChar(64)
  otpHash      String?                  @map("otp_hash") @db.VarChar(64)
  expiresAt    DateTime                 @map("expires_at")
  consumedAt   DateTime?                @map("consumed_at")
  attemptCount Int                      @default(0) @map("attempt_count")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, type, consumedAt])
  @@index([otpHash])
  @@index([expiresAt])
  @@map("identity_verifications")
}

model CustomerProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  locale    String    @default("en_NG") @db.VarChar(10)
  timezone  String    @default("Africa/Lagos") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@map("customer_profiles")
}

model CustomerAddress {
  id            String       @id @default(uuid()) @db.Uuid
  customerId    String       @map("customer_id") @db.Uuid
  label         AddressLabel
  recipientName String       @map("recipient_name") @db.VarChar(150)
  phone         String       @db.VarChar(32)
  addressLine1  String       @map("address_line1") @db.VarChar(255)
  addressLine2  String?      @map("address_line2") @db.VarChar(255)
  landmark      String?      @db.VarChar(255)
  city          String       @db.VarChar(100)
  state         String       @db.VarChar(100)
  country       String       @db.VarChar(100)
  postalCode    String?      @map("postal_code") @db.VarChar(20)
  latitude      Decimal      @db.Decimal(10, 7)
  longitude     Decimal      @db.Decimal(10, 7)
  isDefault     Boolean      @default(false) @map("is_default")
  isActive      Boolean      @default(true) @map("is_active")
  verifiedAt    DateTime?    @map("verified_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  deletedAt     DateTime?    @map("deleted_at")
  customer      User         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([latitude])
  @@index([longitude])
  @@index([isDefault])
  @@index([customerId, deletedAt])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

model MerchantProfile {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @unique @map("user_id") @db.Uuid
  status         MerchantStatus      @default(PENDING)
  isApproved     Boolean             @default(false) @map("is_approved")
  approvedAt     DateTime?           @map("approved_at")
  approvedBy     String?             @map("approved_by") @db.Uuid
  rejectedReason String?             @map("rejected_reason") @db.VarChar(1000)
  suspendedAt    DateTime?           @map("suspended_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  deletedAt      DateTime?           @map("deleted_at")
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding     MerchantOnboarding?
  products       Product[]

  @@index([status])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("merchant_profiles")
}

model Business {
  id                 String                     @id @default(uuid()) @db.Uuid
  merchantId         String                     @unique @map("merchant_id") @db.Uuid
  businessName       String                     @map("business_name") @db.VarChar(150)
  businessType       BusinessType               @map("business_type")
  /// What this merchant sells. Nullable: every merchant onboarded before this
  /// column existed has none, and a wrong guess is worse than an honest blank
  /// — an uncategorised merchant still appears under "All", it just cannot be
  /// filtered to a category until someone sets one.
  category           MerchantCategory?
  registrationNumber String                     @unique @map("registration_number") @db.VarChar(100)
  taxNumber          String?                    @map("tax_number") @db.VarChar(100)
  description        String?                    @db.VarChar(2000)
  email              String                     @db.Citext
  phone              String                     @db.VarChar(32)
  country            String                     @db.VarChar(100)
  state              String                     @db.VarChar(100)
  city               String                     @db.VarChar(100)
  address            String                     @db.VarChar(500)
  latitude           Decimal                    @db.Decimal(10, 7)
  longitude          Decimal                    @db.Decimal(10, 7)
  logoUrl            String?                    @map("logo_url") @db.VarChar(2048)
  coverPhotoUrl      String?                    @map("cover_photo_url") @db.VarChar(2048)
  operatingHours     Json?                      @map("operating_hours")
  status             BusinessStatus             @default(DRAFT)
  verificationStatus BusinessVerificationStatus @default(PENDING) @map("verification_status")
  approvedBy         String?                    @map("approved_by") @db.Uuid
  approvedAt         DateTime?                  @map("approved_at")
  rejectedReason     String?                    @map("rejected_reason") @db.VarChar(1000)
  pausedAt           DateTime?                  @map("paused_at")
  pauseReason        String?                    @map("pause_reason") @db.VarChar(500)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  merchant           User                       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  kycDocuments       MerchantKyc[]

  @@index([status])
  @@index([verificationStatus])
  @@index([country, state])
  @@index([createdAt])
  /// The marketplace's primary browse is "approved merchants in this category".
  @@index([category])
  @@map("businesses")
}

model MerchantKyc {
  id                 String                @id @default(uuid()) @db.Uuid
  merchantId         String                @map("merchant_id") @db.Uuid
  businessId         String                @map("business_id") @db.Uuid
  documentType       KycDocumentType       @map("document_type")
  documentNumber     String                @map("document_number") @db.VarChar(100)
  frontImage         String                @map("front_image") @db.VarChar(2048)
  backImage          String?               @map("back_image") @db.VarChar(2048)
  selfieImage        String?               @map("selfie_image") @db.VarChar(2048)
  verificationStatus KycVerificationStatus @default(PENDING) @map("verification_status")
  reviewedBy         String?               @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?             @map("reviewed_at")
  remarks            String?               @db.VarChar(1000)
  createdAt          DateTime              @default(now()) @map("created_at")
  merchant           User                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  business           Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([businessId])
  @@index([verificationStatus])
  @@index([merchantId, verificationStatus])
  @@map("merchant_kyc")
}

model BankAccount {
  id            String    @id @default(uuid()) @db.Uuid
  merchantId    String    @map("merchant_id") @db.Uuid
  bankName      String    @map("bank_name") @db.VarChar(150)
  accountName   String    @map("account_name") @db.VarChar(150)
  accountNumber String    @map("account_number") @db.VarChar(20)
  currency      String    @default("NGN") @db.VarChar(3)
  isDefault     Boolean   @default(false) @map("is_default")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  merchant      User      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, accountNumber])
  @@index([merchantId])
  @@index([merchantId, isDefault])
  @@map("bank_accounts")
}

model RiderProfile {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @unique @map("user_id") @db.Uuid
  status         RiderStatus      @default(PENDING)
  /// DPX-RIDER-002 — the company/organisation the rider delivers for. Name
  /// only (founder scope: "just name of company, no need much details").
  companyName    String?          @map("company_name") @db.VarChar(200)
  isApproved     Boolean          @default(false) @map("is_approved")
  approvedAt     DateTime?        @map("approved_at")
  approvedBy     String?          @map("approved_by") @db.Uuid
  rejectedReason String?          @map("rejected_reason") @db.VarChar(1000)
  suspendedAt    DateTime?        @map("suspended_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding     RiderOnboarding?

  @@index([isApproved])
  @@index([status])
  @@index([deletedAt])
  @@map("rider_profiles")
}

model DriverProfile {
  id                                 String                     @id @default(uuid()) @db.Uuid
  userId                             String                     @unique @map("user_id") @db.Uuid
  status                             DriverStatus               @default(PENDING)
  isApproved                         Boolean                    @default(false) @map("is_approved")
  approvedAt                         DateTime?                  @map("approved_at")
  approvedBy                         String?                    @map("approved_by") @db.Uuid
  rejectedReason                     String?                    @map("rejected_reason") @db.VarChar(1000)
  suspendedAt                        DateTime?                  @map("suspended_at")
  /// Last time this driver passed a real identity/facial verification
  /// (Smile ID). Null = never verified. Backfilled to `now()` for every
  /// pre-existing driver at migration time so the new gate applies only to
  /// trigger conditions occurring after it ships, not retroactively to
  /// drivers approved before this feature existed. See
  /// docs/DRIVER-001-IDENTITY-VERIFICATION-DESIGN.md.
  lastIdentityVerifiedAt             DateTime?                  @map("last_identity_verified_at")
  /// Non-null = this driver cannot go online until they pass a new
  /// verification. Set by the risk engine (idle timeout / new device /
  /// suspicious activity / account recovery) or a failed verification
  /// attempt; cleared only by a PASSED verification.
  identityVerificationRequiredReason DriverVerificationTrigger? @map("identity_verification_required_reason")
  /// DPX-DS-001: consecutive failed/error verification attempts. Reset to 0
  /// on any PASSED result; hitting the platform's lockout threshold sets
  /// `identityVerificationLockedAt`.
  failedVerificationAttempts         Int                        @default(0) @map("failed_verification_attempts")
  /// DPX-DS-001: non-null = this driver cannot attempt verification at all
  /// until an admin clears it (support-review lock after repeated
  /// failures). Distinct from `identityVerificationRequiredReason`, which
  /// still allows retries.
  identityVerificationLockedAt       DateTime?                  @map("identity_verification_locked_at")
  /// DPX-DRIVER-002 Phase 1
  emergencyContactName               String?                    @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone              String?                    @map("emergency_contact_phone") @db.VarChar(20)
  emergencyContactRelationship       String?                    @map("emergency_contact_relationship") @db.VarChar(50)
  emergencyContactEmail              String?                    @map("emergency_contact_email") @db.VarChar(255)
  /// DPX-DRIVER-002 Phase 4 — non-null = driver has accepted the driver
  /// agreement. `agreementVersion` records which version, so a future
  /// agreement update can require re-acceptance without ambiguity.
  agreementAcceptedAt                DateTime?                  @map("agreement_accepted_at")
  agreementVersion                   String?                    @map("agreement_version") @db.VarChar(20)
  /// Driver Slice 2 item 9 — Profile enhancements (founder-scoped
  /// 2026-08-04). Self-editable by the driver via DriversService.
  /// updateOwnProfile; no file-upload backend exists anywhere in this
  /// codebase (see KycDocumentForm), so avatarUrl follows the same
  /// hosted-URL-string convention as DriverKyc.frontImage rather than a
  /// file picker.
  avatarUrl                          String?                    @map("avatar_url") @db.VarChar(2048)
  languagesSpoken                    String[]                   @default([]) @map("languages_spoken")
  /// Free-text area/city names — there is no formal geo-boundary/zone
  /// model anywhere in this codebase to constrain this against.
  preferredServiceAreas              String[]                   @default([]) @map("preferred_service_areas")
  drivingExperienceYears             Int?                       @map("driving_experience_years")
  createdAt                          DateTime                   @default(now()) @map("created_at")
  updatedAt                          DateTime                   @updatedAt @map("updated_at")
  deletedAt                          DateTime?                  @map("deleted_at")
  user                               User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboarding                         DriverOnboarding?

  @@index([status])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("driver_profiles")
}

enum IdentityVerificationProvider {
  SMILE_ID
  MANUAL_REVIEW
}

enum DriverVerificationTrigger {
  ONBOARDING
  IDLE_TIMEOUT
  NEW_DEVICE
  SUSPICIOUS_ACTIVITY
  ACCOUNT_RECOVERY
  MANUAL_ADMIN
  /// DPX-DS-001
  CREDENTIAL_CHANGE
  FAILED_LOGIN_LOCKOUT
  FIRST_LOGIN_OF_DAY
  GPS_ANOMALY
  RANDOM_SPOT_CHECK
  /// DPX-DS-001 — reserved, not yet wired (no phone-change flow exists; see design doc addendum)
  PHONE_NUMBER_CHANGED
}

enum DriverVerificationStatus {
  PENDING
  PASSED
  FAILED
  ERROR
}

/// Append-only audit trail of every identity/facial verification attempt —
/// onboarding enrollment and every risk-triggered re-verification. Never
/// updated after completion; DriverProfile's two fields above are the live
/// enforcement state. See docs/DRIVER-001-IDENTITY-VERIFICATION-DESIGN.md.
model DriverIdentityVerification {
  id                String                       @id @default(uuid()) @db.Uuid
  driverId          String                       @map("driver_id") @db.Uuid
  provider          IdentityVerificationProvider
  trigger           DriverVerificationTrigger
  status            DriverVerificationStatus     @default(PENDING)
  confidenceScore   Decimal?                     @map("confidence_score") @db.Decimal(5, 2)
  providerReference String?                      @map("provider_reference") @db.VarChar(255)
  deviceId          String?                      @map("device_id") @db.VarChar(255)
  ipAddress         String?                      @map("ip_address") @db.VarChar(45)
  sessionId         String?                      @map("session_id") @db.Uuid
  latitude          Decimal?                     @db.Decimal(10, 7)
  longitude         Decimal?                     @db.Decimal(10, 7)
  failureReason     String?                      @map("failure_reason") @db.VarChar(1000)
  requestedAt       DateTime                     @default(now()) @map("requested_at")
  completedAt       DateTime?                    @map("completed_at")
  createdAt         DateTime                     @default(now()) @map("created_at")
  driver            User                         @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt(sort: Desc)])
  @@index([status])
  @@map("driver_identity_verifications")
}

/// Admin-configurable Driver-001 Security Standard policy. Single row
/// (fixed well-known id, enforced at the service layer) — the effective
/// values every "go online" risk-engine check reads, editable without a
/// redeploy. AppConfigService/env vars only seed this row's initial
/// values the first time it's created.
model DriverSecuritySettings {
  id                            String   @id @db.Uuid
  idleHours                     Int      @map("idle_hours")
  gpsAnomalySpeedKmh            Float    @map("gps_anomaly_speed_kmh")
  lockoutThreshold              Int      @map("lockout_threshold")
  spotCheckDenominator          Int      @map("spot_check_denominator")
  newDeviceVerificationEnabled  Boolean  @default(true) @map("new_device_verification_enabled")
  adminForceVerificationEnabled Boolean  @default(true) @map("admin_force_verification_enabled")
  /// Whether a VERIFIED driver is asked to re-verify periodically — first
  /// login of the day, after an idle gap, or on a new device. Onboarding is
  /// never affected: a driver who has never been verified is always required
  /// to be, and an operator can clear that by manual review.
  ///
  /// Switchable because the periodic checks are the expensive ones: a
  /// biometric vendor charges per snap, and re-checking every driver every
  /// morning multiplies that by the whole fleet, every day.
  periodicVerificationEnabled   Boolean  @default(true) @map("periodic_verification_enabled")
  updatedBy                     String?  @map("updated_by") @db.Uuid
  updatedAt                     DateTime @updatedAt @map("updated_at")
  createdAt                     DateTime @default(now()) @map("created_at")

  @@map("driver_security_settings")
}

/// A device fingerprint this driver has previously completed a PASSED
/// verification from. "New device" = no row here for the fingerprint
/// presented at go-online time.
model DriverVerifiedDevice {
  driverId          String   @map("driver_id") @db.Uuid
  deviceFingerprint String   @map("device_fingerprint") @db.VarChar(64)
  firstVerifiedAt   DateTime @default(now()) @map("first_verified_at")
  lastSeenAt        DateTime @updatedAt @map("last_seen_at")
  driver            User     @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@id([driverId, deviceFingerprint])
  @@map("driver_verified_devices")
}

