{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dripplex-customer-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dripplex-customer-web",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "NEXTJS_ENV": "production",
  },
  // Optional incremental cache — uncomment after creating the R2 bucket:
  // "r2_buckets": [
  //   {
  //     "binding": "NEXT_INC_CACHE_R2_BUCKET",
  //     "bucket_name": "dripplex-customer-web-cache",
  //   },
  // ],
}
