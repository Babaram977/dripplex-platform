# syntax=docker/dockerfile:1.7
# Shared Next.js portal image (Program D2)
# Build args:
#   APP_NAME  = customer-web | merchant-portal | rider-portal | admin-portal
#   APP_PORT  = 3001 | 3002 | 3003 | 3004
#   FILTER    = @dripplex/<app>
#   NEXT_PUBLIC_API_BASE_URL / NEXT_PUBLIC_APP_URL

ARG APP_NAME=customer-web
ARG APP_PORT=3001
ARG FILTER=@dripplex/customer-web

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app

FROM base AS deps
ARG APP_NAME
ARG FILTER
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY packages/config/package.json packages/config/
COPY packages/types/package.json packages/types/
COPY packages/utils/package.json packages/utils/
COPY packages/sdk/package.json packages/sdk/
COPY packages/ui/package.json packages/ui/
COPY packages/hooks/package.json packages/hooks/
COPY apps/${APP_NAME}/package.json apps/${APP_NAME}/
RUN pnpm install --filter ${FILTER}... --frozen-lockfile

FROM base AS build
ARG APP_NAME
ARG FILTER
ARG NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
ARG NEXT_PUBLIC_APP_URL=http://localhost:3001
COPY --from=deps /app /app
COPY tsconfig.base.json tsconfig.json turbo.json ./
COPY packages packages
COPY apps/${APP_NAME} apps/${APP_NAME}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
RUN pnpm --filter ${FILTER} build

FROM node:22-bookworm-slim AS runner
ARG APP_NAME
ARG APP_PORT
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV APP_NAME=${APP_NAME}
WORKDIR /app
RUN groupadd --system --gid 1001 dripplex \
  && useradd --system --uid 1001 --gid dripplex dripplex
COPY --from=build --chown=dripplex:dripplex /app/apps/${APP_NAME}/.next/standalone ./
COPY --from=build --chown=dripplex:dripplex /app/apps/${APP_NAME}/.next/static ./apps/${APP_NAME}/.next/static
COPY --from=build --chown=dripplex:dripplex /app/apps/${APP_NAME}/public ./apps/${APP_NAME}/public
USER dripplex
ENV PORT=${APP_PORT}
ENV HOSTNAME=0.0.0.0
EXPOSE ${APP_PORT}
CMD ["sh", "-c", "node apps/${APP_NAME}/server.js"]