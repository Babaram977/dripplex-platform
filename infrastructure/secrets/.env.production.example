# Production env template — copy to secret manager / host .env.production / Cloudflare Worker secrets.
# Never commit real values. Documented for Program D1 live launch.

NODE_ENV=production

# ── Public URLs ──────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://api.dripplex.com/api/v1
NEXT_PUBLIC_APP_URL=https://www.dripplex.com
# Optional alias for customer app hostname
# NEXT_PUBLIC_APP_URL=https://app.dripplex.com
CORS_ORIGINS=https://www.dripplex.com,https://app.dripplex.com,https://dripplex.com,https://merchant.dripplex.com,https://rider.dripplex.com,https://admin.dripplex.com,https://ops.dripplex.com

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=dripplex
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=dripplex
DATABASE_URL=postgresql://dripplex:replace-me@pgbouncer:5432/dripplex?schema=public&pgbouncer=true

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0

# ── Auth / JWT ───────────────────────────────────────────────
# Backend validates JWT_ACCESS_SECRET / JWT_REFRESH_SECRET (≥32 chars).
JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
# Aliases sometimes used in external runbooks (map to ACCESS/REFRESH above):
# JWT_SECRET=${JWT_ACCESS_SECRET}
# JWT_REFRESH_SECRET already set
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_TTL_SECONDS=604800

# ── SMTP / Email ─────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true
EMAIL_FROM=noreply@dripplex.com
EMAIL_FROM_NAME=Dripplex
# Optional transactional provider
# RESEND_API_KEY=

# ── SMS (Termii) ─────────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Dripplex
TERMII_BASE_URL=https://api.ng.termii.com

# ── Payments (Paystack) ──────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# Which gateway a plain "pay by card" actually uses. Both providers can be
# configured at once; this picks the live one, and switching it needs no
# deploy. A value naming a gateway with no secret key falls back to whichever
# one IS configured rather than silently disabling card payments. Never OPay —
# it is safe-disabled platform-wide (DPX-D1).
PAYMENT_DEFAULT_PROVIDER=PAYSTACK
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
OPAY_API_KEY=

# Peyflex — the bill-payment aggregator behind the Utilities tab
# (DPX-UTILITIES-001/-002). The token is a static Django REST Framework token
# from the Peyflex dashboard and spends a PREFUNDED DrippleX float, so anyone
# holding it can spend real money. Leave blank to ship the feature
# deployed-but-disabled: the not-configured adapter refuses every call and the
# Utilities tab badges itself unavailable rather than failing after a customer
# has chosen a bundle.
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=
# The float is shared by every utility purchase on the platform, so it running
# dry fails all four services at once. Ops is alarmed at this balance, not at
# zero.
PEYFLEX_FLOAT_LOW_BALANCE_THRESHOLD=50000

# ── Maps ─────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Google Sign-In (DPX-LAUNCH-003) ─────────────────────────
# See docs/ops/DPX-LAUNCH-003-GOOGLE-SIGNIN.md for the exact redirect URI
# to register in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.dripplex.com/api/v1/auth/google/callback
CUSTOMER_APP_URL=https://www.dripplex.com

# ── Notification providers (DPX-LAUNCH-005) ──────────────────
# SMS (Termii) and email (Resend) delivery for OTP, password reset, email
# verification, and order/ride lifecycle notifications. Each activates
# independently -- leaving either blank keeps that channel on the
# log-only fallback (no crash, but no real delivery either). See
# docs/ops/DPX-LAUNCH-005-NOTIFICATION-PROVIDERS.md.
TERMII_API_KEY=
TERMII_SENDER_ID=DrippleX
TERMII_BASE_URL=https://api.ng.termii.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=DrippleX <no-reply@dripplex.com>

# ── Observability (Sentry) ───────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
GRAFANA_ADMIN_PASSWORD=replace-me
SLACK_WEBHOOK_URL=
ONCALL_SLACK_CHANNEL=#dripplex-oncall

# ── Object storage (Cloudflare R2) ───────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=dripplex-uploads
R2_BUCKET_CMS=dripplex-cms
R2_BUCKET_PRIVATE=dripplex-private
R2_PUBLIC_BASE_URL=https://cdn.dripplex.com

# ── Backups (B2) ─────────────────────────────────────────────
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=dripplex-backups
AGE_RECIPIENT=age1...

# ── Cloudflare account / deploy ──────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Workers Builds / Wrangler use the token above (Account → Workers Scripts Edit + Account Settings Read)

# ── Cloudflare Worker vars (non-secret; set in wrangler / dashboard) ──
# NEXTJS_ENV=production
# NEXT_PUBLIC_* are build-time for OpenNext (Workers Builds variables)

# ── Cloudflare Worker Secrets (wrangler secret put) ──────────
# Typically not required for static Next portals calling public API.
# Backend secrets stay on the API host / Containers, not on portal Workers.

# ── Cloudflare bindings (create in dashboard; wire in wrangler.jsonc) ──
# KV:        CACHE / SESSION (optional OpenNext incremental cache)
# R2:        NEXT_INC_CACHE_R2_BUCKET (optional)
# D1:        not used by NestJS backend (Postgres is primary)
# Queues:    optional background jobs on Workers; Nest uses Redis queues today

# ── Images (CI overrides) ────────────────────────────────────
MERCHANT_IMAGE=ghcr.io/babaram977/dripplex-merchant-portal:1.0.0
RIDER_IMAGE=ghcr.io/babaram977/dripplex-rider-portal:1.0.0
ADMIN_IMAGE=ghcr.io/babaram977/dripplex-admin-portal:1.0.0
CUSTOMER_IMAGE=ghcr.io/babaram977/dripplex-customer-web:1.0.0
BACKEND_IMAGE=ghcr.io/babaram977/dripplex-backend-core:1.0.0
