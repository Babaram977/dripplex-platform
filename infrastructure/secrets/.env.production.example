# Production env template — copy to secret manager / host .env.production
# Never commit real values.

NODE_ENV=production

# Public URLs
NEXT_PUBLIC_API_BASE_URL=https://api.dripplex.com/api/v1
NEXT_PUBLIC_APP_URL=https://www.dripplex.com
CORS_ORIGINS=https://www.dripplex.com,https://dripplex.com,https://merchant.dripplex.com,https://rider.dripplex.com,https://admin.dripplex.com

# Database (prefer pgbouncer service hostname in compose)
POSTGRES_USER=dripplex
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=dripplex
DATABASE_URL=postgresql://dripplex:replace-me@pgbouncer:5432/dripplex?schema=public&pgbouncer=true

# Redis
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:replace-me@redis:6379/0

# Auth
JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYMENT_DEFAULT_PROVIDER=PAYSTACK

# Object storage (R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_UPLOADS=dripplex-uploads
R2_PUBLIC_BASE_URL=https://cdn.dripplex.com

# Backups (B2)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=dripplex-backups
AGE_RECIPIENT=age1...

# Observability
LOG_LEVEL=info
GRAFANA_ADMIN_PASSWORD=replace-me
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0-rc.1
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_DSN=
SLACK_WEBHOOK_URL=
ONCALL_SLACK_CHANNEL=#dripplex-oncall

# Images (optional overrides)
MERCHANT_IMAGE=dripplex/merchant-portal:1.0.0-rc.1
RIDER_IMAGE=dripplex/rider-portal:1.0.0-rc.1
ADMIN_IMAGE=dripplex/admin-portal:1.0.0-rc.1
