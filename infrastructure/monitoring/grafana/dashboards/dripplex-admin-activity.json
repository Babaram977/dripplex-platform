{
  "title": "DrippleX Admin Activity",
  "uid": "dripplex-admin-activity",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["dripplex", "d3"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Admin portal probe",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"https://admin.dripplex.com/\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Admin host traffic",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{host=\"admin.dripplex.com\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
