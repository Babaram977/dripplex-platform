{
  "title": "Dripplex Rider Activity",
  "uid": "dripplex-rider-activity",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["dripplex", "d3"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Rider portal probe",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"https://rider.dripplex.com/\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rider host traffic",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum(rate(nginx_http_requests_total{host=\"rider.dripplex.com\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
