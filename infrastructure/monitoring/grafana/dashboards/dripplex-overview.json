{
  "title": "DrippleX Platform Overview",
  "uid": "dripplex-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["dripplex", "d3"],
  "panels": [
    {
      "type": "stat",
      "title": "API health",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-api-health\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "WWW up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"https://www.dripplex.com/\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Merchant up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"https://merchant.dripplex.com/\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Rider up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "probe_success{instance=\"https://rider.dripplex.com/\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory %",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Probe success",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox-https\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
