# Dripplex environment template (RC1 / 1.0.0-rc.1)
# Copy to `.env` for local development. Never commit real secrets.
# Production: inject via secret manager. See docs/ops/PRODUCTION-CONFIG.md

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dripplex:dripplex@localhost:5432/dripplex?schema=public
POSTGRES_USER=dripplex
POSTGRES_PASSWORD=dripplex
POSTGRES_DB=dripplex
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Backend API
API_HOST=0.0.0.0
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# Production: comma-separated HTTPS origins only (customer, merchant, rider, admin, ops)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# Auth (generate strong values for non-local environments; min 32 chars)
JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_EMAIL_TTL_SECONDS=600
OTP_SMS_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=5
OTP_DAILY_LIMIT=10
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS_PER_EMAIL=10
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_SECONDS=900

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Frontend public URLs (production: https://…)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Dripplex
NEXT_PUBLIC_APP_TAGLINE=life, Simplified

# Customer web
CUSTOMER_WEB_PORT=3001

# Observability
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=

# Password reset (S1-C5)
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_FORGOT_MAX_PER_HOUR=5
OTP_RESET_TTL_SECONDS=900

# Identity verification (S1-C6)
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_PER_HOUR=5
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_PER_HOUR=5
IDENTITY_VERIFICATION_MAX_ATTEMPTS=10
IDENTITY_VERIFICATION_LOCKOUT_SECONDS=1800
IDENTITY_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Session activity throttle (S1-C7)
SESSION_ACTIVITY_THROTTLE_SECONDS=60

# Payments (S1-C12) — required for staging payment smoke
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
MONIEPOINT_API_KEY=
PAYMENT_DEFAULT_PROVIDER=PAYSTACK

# Push notifications (DPX-CORE-001) — Firebase Admin SDK service account.
# Leave blank to keep PUSH on NotConfiguredProvider. FIREBASE_PRIVATE_KEY
# must keep its literal \n line-break escapes (paste it exactly as it
# appears in the downloaded service account JSON's "private_key" field).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
