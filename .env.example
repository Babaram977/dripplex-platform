# Dripplex environment template (RC1 / 1.0.0-rc.1)
# Copy to `.env` for local development. Never commit real secrets.
# Production: inject via secret manager. See docs/ops/PRODUCTION-CONFIG.md

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://dripplex:dripplex@localhost:5432/dripplex?schema=public
POSTGRES_USER=dripplex
POSTGRES_PASSWORD=dripplex
POSTGRES_DB=dripplex
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Backend API
API_HOST=0.0.0.0
API_PORT=3000
API_GLOBAL_PREFIX=api/v1
# Production: comma-separated HTTPS origins only (customer, merchant, rider, admin, ops)
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://localhost:3006

# Auth (generate strong values for non-local environments; min 32 chars)
JWT_ACCESS_SECRET=replace-with-at-least-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-at-least-32-character-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=300
OTP_EMAIL_TTL_SECONDS=600
OTP_SMS_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_HOURLY_LIMIT=5
OTP_DAILY_LIMIT=10
BCRYPT_SALT_ROUNDS=12
LOGIN_MAX_ATTEMPTS_PER_EMAIL=10
LOGIN_MAX_ATTEMPTS_PER_IP=30
LOGIN_LOCKOUT_SECONDS=900

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Frontend public URLs (production: https://…)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=Dripplex
NEXT_PUBLIC_APP_TAGLINE=life, Simplified

# Customer web
CUSTOMER_WEB_PORT=3001

# Firebase web push (DPX-CORE-001 Phase D-2, customer-web only). Public
# web-app config from Firebase Console -> Project Settings -> General ->
# "Your apps" -- not a secret, unlike the Admin SDK service account below.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyD0vd9bRE56mvy4Uwpt12_qJY82DpCgOtM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=dripplex-3a92d.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=dripplex-3a92d
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=520536680214
NEXT_PUBLIC_FIREBASE_APP_ID=1:520536680214:web:6ca4773b35ee5df9b29237
NEXT_PUBLIC_FIREBASE_VAPID_KEY=BLGk982mqbvWwrqBjLcTOstZSx9PEPe_whVEsJNYDcsYt4GidzUU-45AAyDrv8W_CVCbkAfRa0UJqL1vTiZ0qxc

# Google Maps (Launch Mode Phase 1). Server-side key for backend reverse
# geocoding (apps/backend/src/addresses/geocoding/google-reverse-geocoder.ts)
# -- keep this one out of any frontend bundle. Currently the same broad
# "Maps Platform API Key" as the frontend NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
# above, unrestricted, for dev unblock; split into a dedicated key
# restricted to Geocoding API + IP address before launch (see
# docs/LAUNCH-READINESS-CREDENTIALS.md).
GOOGLE_MAPS_SERVER_API_KEY=AIzaSyB6NzMSnB5nPcTE3rhR_XihCokp-Dkk4-A

# Google Sign-In (DPX-LAUNCH-003). OAuth Client credentials from Google
# Cloud Console. Safe to leave unset -- the /auth/google routes return a
# clear "not configured" error rather than crashing the app. See
# docs/ops/DPX-LAUNCH-003-GOOGLE-SIGNIN.md for the exact redirect URI to
# register and full setup instructions.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Where the OAuth callback redirects the browser back to after sign-in.
CUSTOMER_APP_URL=http://localhost:3001

# Production notification providers (DPX-LAUNCH-005). Each channel
# activates independently once its own key is set; leaving either blank
# keeps that channel on the log-only fallback (safe, no crash) rather than
# actually texting/emailing anyone. See
# docs/ops/DPX-LAUNCH-005-NOTIFICATION-PROVIDERS.md for setup.
TERMII_API_KEY=
TERMII_SENDER_ID=DrippleX
TERMII_BASE_URL=https://api.ng.termii.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=DrippleX <no-reply@dripplex.com>

# Observability
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.0
NEXT_PUBLIC_SENTRY_DSN=

# Password reset (S1-C5)
PASSWORD_RESET_TOKEN_TTL_SECONDS=900
PASSWORD_FORGOT_MAX_PER_HOUR=5
OTP_RESET_TTL_SECONDS=900

# Identity verification (S1-C6)
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_MAX_PER_HOUR=5
PHONE_OTP_TTL_SECONDS=300
PHONE_OTP_MAX_PER_HOUR=5
IDENTITY_VERIFICATION_MAX_ATTEMPTS=10
IDENTITY_VERIFICATION_LOCKOUT_SECONDS=1800
IDENTITY_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# Session activity throttle (S1-C7)
SESSION_ACTIVITY_THROTTLE_SECONDS=60

# Payments (S1-C12) — required for staging payment smoke
# Paystack Test Mode keys (Launch Readiness Phase 1). Real, currently valid
# test-mode credentials from the DrippleX Paystack account — safe by design
# (Paystack test keys move no real money and are scoped to Test Mode only).
# Before launch: replace with Live keys from Settings -> API Keys & Webhooks
# after completing Paystack business verification/2FA — see
# docs/PAYSTACK-INTEGRATION.md.
PAYSTACK_SECRET_KEY=sk_test_c48b7e7abfb28d33ca5daa1c0cdcfb3608f0af8d
PAYSTACK_PUBLIC_KEY=pk_test_76915d525ca49ba77796588836998ab02ed54a7ff
PAYSTACK_BASE_URL=https://api.paystack.co
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com
OPAY_API_KEY=
# Which gateway a plain "pay by card" actually uses. Both providers can be
# configured at once; this picks the live one, and switching it needs no
# deploy. A value naming a gateway with no secret key falls back to whichever
# one IS configured rather than silently disabling card payments. Never OPay —
# it is safe-disabled platform-wide (DPX-D1).
PAYMENT_DEFAULT_PROVIDER=PAYSTACK

# Peyflex — the bill-payment aggregator behind the Utilities tab
# (DPX-UTILITIES-001/-002). The token is a static Django REST Framework token
# from the Peyflex dashboard and spends a PREFUNDED DrippleX float, so anyone
# holding it can spend real money. Leave blank to ship the feature
# deployed-but-disabled: the not-configured adapter refuses every call and the
# Utilities tab badges itself unavailable rather than failing after a customer
# has chosen a bundle.
PEYFLEX_BASE_URL=https://client.peyflex.com.ng
PEYFLEX_API_TOKEN=
# The float is shared by every utility purchase on the platform, so it running
# dry fails all four services at once. Ops is alarmed at this balance, not at
# zero.
PEYFLEX_FLOAT_LOW_BALANCE_THRESHOLD=50000

# Push notifications (DPX-CORE-001) — Firebase Admin SDK service account.
# Leave blank to keep PUSH on NotConfiguredProvider. FIREBASE_PRIVATE_KEY
# must keep its literal \n line-break escapes (paste it exactly as it
# appears in the downloaded service account JSON's "private_key" field).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# In-app voice calling (DPX-MOBILE-002) — LiveKit. Leave blank to keep calling
# on NotConfiguredCallTokenMinter: the routes still exist and answer "Calling
# is not available" rather than the process failing to boot.
#
# LIVEKIT_URL is the wss:// endpoint the client connects to. LIVEKIT_API_SECRET
# signs access tokens SERVER-SIDE ONLY — like the Firebase private key above it
# must never reach a client bundle or the APK. The client receives a token,
# never a key.
#
# Region matters more than usual: media is relayed by this server, so an
# endpoint outside West Africa routes every Kano-to-Kano call out and back.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Object storage (DPX-DRIVER-016) — S3-compatible provider for signed
# direct-to-storage uploads (POST /uploads/sign). Works with Cloudflare R2 or
# AWS S3; leave blank to keep uploads disabled (the endpoint returns a clear
# "not configured" error rather than crashing the app). For R2, ENDPOINT is
# https://<account-id>.r2.cloudflarestorage.com and REGION is "auto"; for AWS,
# ENDPOINT is https://s3.<region>.amazonaws.com and REGION is that region.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
# Optional public/CDN base URL objects are served from (falls back to the
# endpoint/bucket path when blank).
OBJECT_STORAGE_PUBLIC_BASE_URL=

# --- Feature activation (staged launch) ---
# Merchant module: fully built but deployed-but-disabled until the controlled
# merchant pilot. 'false' (default) rejects every merchant-facing endpoint;
# set 'true' to activate the merchant cohort. Admin merchant review/approval and
# customer browse are not affected by this flag.
MERCHANT_MODULE_ENABLED=false

# Portal email activation (temporary, SMS-provider dependent). While the Termii
# SMS sender ID is pending approval, phone OTPs can't be delivered, so
# merchant/driver/rider self-registration would be stuck at PENDING_VERIFICATION.
# 'true' lets those three portals activate + sign in on EMAIL verification alone
# (no phone OTP dispatched, phone verification not required). Customer is
# unaffected. Set back to 'false' once Termii SMS is live to restore mandatory
# phone verification for those portals.
PORTAL_EMAIL_ACTIVATION=false
