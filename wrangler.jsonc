{
  "$schema": "apps/customer-web/node_modules/wrangler/config-schema.json",
  // Prefer Root Directory = apps/customer-web in Workers Builds.
  // Kept for monorepo-root Builds fallback → dripplex-customer-web.
  "name": "dripplex-customer-web",
  "main": "apps/customer-web/.open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "apps/customer-web/.open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dripplex-customer-web",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "routes": [
    { "pattern": "dripplex.com", "custom_domain": true },
    { "pattern": "www.dripplex.com", "custom_domain": true },
    { "pattern": "app.dripplex.com", "custom_domain": true }
  ],
  "vars": {
    "NEXTJS_ENV": "production",
  },
}
