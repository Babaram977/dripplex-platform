{
  "$schema": "apps/customer-web/node_modules/wrangler/config-schema.json",
  // Fallback when Workers Builds Root Directory is the monorepo root.
  // Prefer Root Directory = apps/customer-web (uses apps/customer-web/wrangler.jsonc).
  "name": "dripplex-customer-web",
  "main": "apps/customer-web/.open-next/worker.js",
  "compatibility_date": "2026-07-22",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "apps/customer-web/.open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "dripplex-customer-web",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "vars": {
    "NEXTJS_ENV": "production",
  },
}
